---
const linguagens = [
  { nome: 'HTML', nivel: 'Fundamentos', cor: '#f97316', simbolo: '< />', descricao: 'Estrutura para a web', disponivel: true },
  { nome: 'CSS', nivel: 'Fundamentos', cor: '#38bdf8', simbolo: '{ }', descricao: 'Estilo e interfaces', disponivel: true },
  { nome: 'JavaScript', nivel: 'Essencial', cor: '#facc15', simbolo: 'JS', descricao: 'Interatividade na web', disponivel: true },
  { nome: 'TypeScript', nivel: 'Essencial', cor: '#3b82f6', simbolo: 'TS', descricao: 'JavaScript com tipos', disponivel: true },
  { nome: 'Python', nivel: 'Iniciante', cor: '#22c55e', simbolo: 'Py', descricao: 'Lógica e automação', disponivel: true },
  { nome: 'Java', nivel: 'Intermediário', cor: '#ef4444', simbolo: '☕', descricao: 'Aplicações robustas', disponivel: true },
  { nome: 'C#', nivel: 'Em breve', cor: '#a855f7', simbolo: '🚀', descricao: 'Trilha em construção', disponivel: false },
  { nome: 'React', nivel: 'Em breve', cor: '#61dafb', simbolo: '🚀', descricao: 'Trilha em construção', disponivel: false },
  { nome: 'SQL', nivel: 'Em breve', cor: '#f472b6', simbolo: '🚀', descricao: 'Trilha em construção', disponivel: false },
  { nome: 'Go', nivel: 'Em breve', cor: '#06b6d4', simbolo: '🚀', descricao: 'Trilha em construção', disponivel: false },
  { nome: 'Rust', nivel: 'Em breve', cor: '#fb923c', simbolo: '🚀', descricao: 'Trilha em construção', disponivel: false },
  { nome: 'PHP', nivel: 'Em breve', cor: '#c084fc', simbolo: '🚀', descricao: 'Trilha em construção', disponivel: false },
];
import Navbar  from "../components/Navbar.astro";
import  Footer  from "../components/Footer.astro";

---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Linguagens | Dev Learn</title>
    <meta name="description" content="Explore as principais linguagens de programação na Dev Learn." />
  </head>
  <body>
    <Navbar />
    <main class="page">
      <section class="hero container" aria-labelledby="titulo">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> trilha de aprendizado</p>
          <h1 id="titulo">Escolha sua próxima<br /><strong>linguagem.</strong></h1>
          <p class="intro">Aprenda no seu ritmo, construa projetos incríveis e transforme curiosidade em código.</p>
        </div>

        <div class="stats" aria-label="Informações sobre as trilhas">
          <div><strong>6</strong><span>linguagens disponíveis</span></div>
          <div><strong>∞</strong><span>possibilidades</span></div>
        </div>
      </section>

      <section class="languages container" aria-labelledby="lista-titulo">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span></span> comece agora</p>
            <h2 id="lista-titulo">Encontre seu caminho</h2>
          </div>
          <p class="section-note">Do primeiro código ao próximo grande projeto.</p>
        </div>

        <div class="language-grid">
          {linguagens.map((linguagem, index) => (
            <a class={`language-card card-${(index % 4) + 1} ${linguagem.disponivel ? '' : 'is-coming-soon'}`} href={linguagem.disponivel ? `#${linguagem.nome.toLowerCase()}` : '#em-breve'} aria-label={linguagem.disponivel ? `Aprender ${linguagem.nome}` : `${linguagem.nome}: em breve`} aria-disabled={!linguagem.disponivel} style={`--language-color: ${linguagem.cor}`}>
              <div class="card-top">
                <span class="level">{linguagem.nivel}</span>
                <span class="arrow" aria-hidden="true">{linguagem.disponivel ? '↗' : '—'}</span>
              </div>
              <div class="symbol" aria-hidden="true">{linguagem.simbolo}</div>
              <div class="card-bottom">
                <div>
                  <h3>{linguagem.nome}</h3>
                  <p>{linguagem.descricao}</p>
                </div>
                <span class="line"></span>
              </div>
            </a>
          ))}
        </div>
      </section>

        <Footer />
    </main>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

  :global(*) { box-sizing: border-box; }

  /* Gradiente movido pro body: agora cobre a página inteira,
     incluindo a área atrás do Navbar (que é transparente). */
  :global(body) {
    margin: 0;
    min-width: 320px;
    background:
      radial-gradient(ellipse 58% 34% at 79% 4%, rgb(91 61 255 / 30%) 0%, transparent 72%),
      radial-gradient(ellipse 50% 32% at 12% 45%, rgb(54 38 176 / 20%) 0%, transparent 72%),
      #070a18;
    color: #d8d8ea;
    font-family: 'Poppins', sans-serif;
  }

  :global(a) { color: inherit; text-decoration: none; }
  :global(::selection) { color: #070a18; background: #c084fc; }

  .page {
    min-height: 100vh;
    overflow: hidden;
    padding: 34px 0 28px;
    /* background removido daqui: agora vive no body */
  }

  .container { width: min(1240px, calc(100% - 48px)); margin-inline: auto; }
  .hero { position: relative; min-height: 390px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: #fff; font-size: 20px; font-weight: 700; letter-spacing: -.6px; }
  .brand span:last-child span { color: #c084fc; }
  .brand-mark { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid #a855f7; border-radius: 10px; color: #fff; font-family: monospace; font-size: 12px; box-shadow: 0 0 22px rgb(168 85 247 / 35%); }
  .hero-copy { max-width: 700px; padding-top: 74px; }
  .eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 14px; color: #c084fc; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }
  .eyebrow span { width: 24px; height: 2px; background: linear-gradient(90deg, #ff4fa3, #9b32ff); }
  h1 { margin: 0; color: #fff; font-size: clamp(42px, 7vw, 78px); font-weight: 500; letter-spacing: -4px; line-height: 1.08; }
  h1 strong { color: #c084fc; font-weight: 700; }
  .intro { max-width: 520px; margin: 25px 0 0; color: #9a9bb0; font-size: 16px; }
  .stats { position: absolute; right: 0; bottom: 32px; display: flex; gap: 36px; }
  .stats div { display: flex; flex-direction: column; border-left: 1px solid rgb(192 132 252 / 30%); padding-left: 16px; }
  .stats strong { color: #fff; font-size: 30px; line-height: 1; }
  .stats span { margin-top: 6px; color: #9a9bb0; font-size: 11px; }
  .languages { padding-bottom: 36px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; margin-bottom: 27px; }
  .section-heading h2 { margin: 0; color: #fff; font-size: clamp(26px, 4vw, 38px); letter-spacing: -1.5px; }
  .section-note { max-width: 220px; margin: 0 0 4px; color: #9a9bb0; font-size: 13px; text-align: right; }
  .language-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .language-card { position: relative; display: flex; min-height: 250px; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 20px; border: 1px solid rgb(255 255 255 / 9%); border-radius: 18px; background: linear-gradient(145deg, rgb(255 255 255 / 8%), rgb(255 255 255 / 2%)); transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease; }
  .language-card::before { position: absolute; top: -48px; right: -36px; width: 150px; height: 150px; border-radius: 50%; background: var(--language-color); content: ''; opacity: .12; filter: blur(3px); }
  .language-card:hover { border-color: color-mix(in srgb, var(--language-color), white 25%); box-shadow: 0 16px 35px rgb(0 0 0 / 20%), 0 0 25px color-mix(in srgb, var(--language-color), transparent 78%); transform: translateY(-7px); }
  .language-card.is-coming-soon { cursor: default; opacity: .72; }
  .language-card.is-coming-soon:hover { opacity: .9; transform: translateY(-3px); }
  .card-top, .card-bottom { position: relative; z-index: 1; display: flex; justify-content: space-between; }
  .level { color: #9a9bb0; font-size: 10px; letter-spacing: 1px; text-transform: uppercase; }
  .arrow { color: var(--language-color); font-size: 22px; line-height: 1; }
  .symbol { position: relative; z-index: 1; margin: 14px 0 8px; color: var(--language-color); font-family: monospace; font-size: clamp(35px, 4vw, 53px); font-weight: 700; letter-spacing: -5px; text-shadow: 0 0 24px color-mix(in srgb, var(--language-color), transparent 62%); }
  .card-bottom { align-items: end; }
  h3 { margin: 0; color: #fff; font-size: 21px; font-weight: 600; }
  .card-bottom p { margin: 3px 0 0; color: #9a9bb0; font-size: 11px; }
  .line { width: 27px; height: 3px; margin-bottom: 6px; border-radius: 10px; background: var(--language-color); }
  .footer { display: flex; justify-content: space-between; border-top: 1px solid rgb(255 255 255 / 8%); padding-top: 20px; color: #696a80; font-size: 11px; }
  .footer span:first-child { color: #c084fc; font-weight: 600; }
  @media (max-width: 900px) { .language-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 650px) { .page { padding-top: 22px; } .container { width: min(100% - 32px, 1240px); } .hero { min-height: 450px; } .hero-copy { padding-top: 80px; } .stats { right: auto; bottom: 36px; } .section-heading { align-items: start; flex-direction: column; gap: 8px; } .section-note { text-align: left; } .language-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .language-card { min-height: 205px; padding: 15px; border-radius: 14px; } h3 { font-size: 17px; } .card-bottom p { font-size: 10px; } .footer { flex-direction: column; gap: 5px; } }
  @media (max-width: 390px) { .language-grid { grid-template-columns: 1fr; } .language-card { min-height: 180px; } }
</style>

<style is:global>
  :focus-visible { outline: 3px solid #c084fc; outline-offset: 3px; }
</style>