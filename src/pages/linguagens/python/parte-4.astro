	{ id: 'parte-4-2', title: 'A primeira estrutura if' },
	{ id: 'parte-4-3', title: 'Como o Python avalia uma condição' },
	{ id: 'parte-4-4', title: 'A importância da indentação' },
	{ id: 'parte-4-5', title: 'A estrutura else' },
	{ id: 'parte-4-6', title: 'A estrutura elif' },
	{ id: 'parte-4-7', title: 'Comparação entre if, elif e else' },
	{ id: 'parte-4-8', title: 'Múltiplas condições com and' },
	{ id: 'parte-4-9', title: 'Múltiplas condições com or' },
	{ id: 'parte-4-10', title: 'Negação com not' },
	{ id: 'parte-4-11', title: 'Combinação de and, or e not' },
	{ id: 'parte-4-12', title: 'Condições aninhadas' },
	{ id: 'parte-4-13', title: 'Truthy e falsy em condicionais' },
