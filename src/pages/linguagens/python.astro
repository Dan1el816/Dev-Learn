---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import CodeSample from '../../components/python/CodeSample.astro';
import KeyCallout from '../../components/python/KeyCallout.astro';
import PythonCourseNavigation from '../../components/python/PythonCourseNavigation.astro';

const sections = [
	{ id: 'parte-1-1', title: 'O que é Python?' },
	{ id: 'parte-1-2', title: 'Um pouco da história' },
	{ id: 'parte-1-3', title: 'Por que é tão popular?' },
	{ id: 'parte-1-4', title: 'Onde Python é utilizado?' },
	{ id: 'parte-1-5', title: 'Características da linguagem' },
	{ id: 'parte-1-6', title: 'Seu primeiro código' },
	{ id: 'parte-1-7', title: 'Instalar e verificar' },
	{ id: 'parte-1-8', title: 'Como executar Python' },
	{ id: 'parte-1-9', title: 'Interpretador e REPL' },
	{ id: 'parte-1-10', title: 'Arquivos .py' },
	{ id: 'parte-1-11', title: 'Comentários' },
	{ id: 'parte-1-12', title: 'Conceitos fundamentais' },
	{ id: 'parte-1-13', title: 'Como ler código Python' },
	{ id: 'parte-1-14', title: 'Python e outras linguagens' },
	{ id: 'parte-1-15', title: 'Vantagens e limitações' },
	{ id: 'parte-1-16', title: 'Erros comuns de iniciantes' },
	{ id: 'parte-1-17', title: 'Como estudar Python' },
];

const areas = [
	{
		title: 'Desenvolvimento web',
		text: 'Crie sites e serviços que recebem requisições, processam informações e devolvem páginas ou dados. Django, Flask e FastAPI são ferramentas usadas nesse espaço.',
		tag: 'Django · Flask · FastAPI',
	},
	{
		title: 'Ciência de dados',
		text: 'Explore conjuntos de dados, faça análises estatísticas e comunique resultados com tabelas e gráficos. NumPy, Pandas e Matplotlib são exemplos do ecossistema.',
		tag: 'NumPy · Pandas · Matplotlib',
	},
	{
		title: 'Inteligência artificial',
		text: 'Prepare dados e experimente modelos de aprendizado de máquina para tarefas como classificação ou previsão. Há ferramentas como scikit-learn, TensorFlow e PyTorch.',
		tag: 'scikit-learn · TensorFlow · PyTorch',
	},
	{
		title: 'Automação',
		text: 'Escreva pequenos programas para organizar arquivos, processar informações ou automatizar etapas repetitivas do trabalho.',
		tag: 'Scripts · arquivos · tarefas',
	},
	{
		title: 'Backend e APIs',
		text: 'Implemente a parte de um sistema que roda no servidor e crie APIs — interfaces que permitem que programas troquem dados.',
		tag: 'Serviços · integrações',
	},
	{
		title: 'Educação',
		text: 'Use uma sintaxe legível para aprender lógica de programação, testar ideias e criar projetos didáticos.',
		tag: 'Aprendizagem · protótipos',
	},
	{
		title: 'Segurança e ferramentas',
		text: 'Apoie análises defensivas, automatize verificações autorizadas e processe registros para entender o funcionamento de sistemas.',
		tag: 'Análise · automação defensiva',
	},
];

const concepts = [
	{ title: 'Valor', text: 'Uma informação concreta usada pelo programa.', example: '"Oi"  ·  12' },
	{ title: 'Expressão', text: 'Um trecho que pode ser avaliado para produzir um valor.', example: '10 + 5  →  15' },
	{ title: 'Instrução', text: 'Uma ordem que o programa executa.', example: 'print("Oi")' },
	{ title: 'Objeto', text: 'Uma entidade criada durante a execução, com valor e comportamento.', example: 'O texto "Oi" é um objeto.' },
	{ title: 'Variável', text: 'Um nome associado a um valor; será estudada na próxima parte.', example: 'nome = "Ana"' },
	{ title: 'Tipo', text: 'Uma categoria que define que valores e operações são compatíveis.', example: '12 é inteiro; "Oi" é texto.' },
	{ title: 'Função', text: 'Uma operação identificada por um nome e que pode ser chamada.', example: 'print("Oi")' },
];

const exercises = [
	{
		title: 'Imprima uma mensagem',
		level: 'Fácil',
		prompt: 'Escreva uma linha que mostre uma mensagem de boas-vindas.',
		hint: 'Use `print()` e coloque o texto entre aspas.',
		solution: 'print("Bem-vinda ao Python!")',
		output: 'Bem-vinda ao Python!',
	},
	{
		title: 'Apresente seu nome',
		level: 'Fácil',
		prompt: 'Mostre seu nome na tela usando uma única chamada a `print()`.',
		hint: 'Um nome escrito entre aspas é tratado como texto.',
		solution: 'print("Ana")',
		output: 'Ana',
	},
	{
		title: 'Faça uma conta',
		level: 'Fácil',
		prompt: 'Exiba o resultado de 18 dividido por 3.',
		hint: 'Coloque a expressão matemática dentro de `print()`.',
		solution: 'print(18 / 3)',
		output: '6.0',
	},
	{
		title: 'Adicione um comentário',
		level: 'Fácil',
		prompt: 'Acrescente um comentário explicando por que o programa mostra uma saudação.',
		hint: 'Comece a linha de comentário com `#`.',
		solution: '# Saudação inicial do programa\nprint("Olá!")',
		output: 'Olá!',
	},
	{
		title: 'Monte uma apresentação',
		level: 'Médio',
		prompt: 'Use várias chamadas a `print()` para mostrar uma saudação, uma área de interesse e uma mensagem final.',
		hint: 'Cada chamada pode exibir uma linha diferente.',
		solution: 'print("Olá!")\nprint("Estou aprendendo programação.")\nprint("Este é meu primeiro programa.")',
		output: 'Olá!\nEstou aprendendo programação.\nEste é meu primeiro programa.',
	},
	{
		title: 'Encontre o erro',
		level: 'Médio',
		prompt: 'Corrija o código para que ele mostre `Vamos começar!`.',
		hint: 'Confira se os parênteses e as aspas foram abertos e fechados.',
		solution: 'print("Vamos começar!")',
		output: 'Vamos começar!',
	},
	{
		title: 'Preveja a saída',
		level: 'Médio',
		prompt: 'Antes de executar, escreva qual será a saída deste código.',
		hint: 'A operação matemática é calculada antes de `print()` exibir o resultado.',
		solution: 'print(7 + 4)\n\n# Saída:\n11',
		output: '11',
	},
];
---

<Layout title="Parte 1 — Introdução ao Python | Dev Learn">
	<div class="python-page">
		<Navbar />
		<div class="python-course-layout">
			<PythonCourseNavigation />
			<div class="container course-content">
			<header class="course-hero">
				<a class="back-link" href="/linguagens">← Todas as linguagens</a>
				<p class="eyebrow"><span></span> Trilha de Python · Parte 1</p>
				<h1>Introdução ao <span>Python</span></h1>
				<p class="hero-lead">
					Conheça a linguagem, entenda como um programa é executado e escreva seu primeiro código.
					Esta introdução foi pensada para quem está começando.
				</p>
				<div class="course-meta">
					<span><i aria-hidden="true">✓</i> Pré-requisitos: nenhum</span>
					<a href="/linguagens/python/fundamentos">Conteúdo complementar: tipos, condicionais e laços <span aria-hidden="true">↗</span></a>
				</div>
				<div class="objectives">
					<h2>Ao final desta parte, você será capaz de:</h2>
					<ul>
						<li>explicar para que Python serve e onde é utilizado;</li>
						<li>reconhecer os elementos de um pequeno programa;</li>
						<li>verificar a instalação e executar código no REPL e em um arquivo;</li>
						<li>usar `print()`, textos, contas simples e comentários.</li>
					</ul>
				</div>
			</header>

			<nav class="toc" aria-label="Índice desta parte">
				<div class="toc-heading">
					<p class="eyebrow"><span></span> Roteiro de estudo</p>
					<h2>Nesta parte</h2>
				</div>
				<ol>
					{sections.map((section, index) => (
						<li>
							<a href={`#${section.id}`}>
								<span>{String(index + 1).padStart(2, '0')}</span>
								{section.title}
							</a>
						</li>
					))}
				</ol>
			</nav>

			<article class="lesson" aria-label="Parte 1 — Introdução ao Python">
				<section class="lesson-section" id="parte-1-1" aria-labelledby="title-1-1">
					<div class="section-heading"><span class="section-number">1.1</span><div><p class="eyebrow"><span></span> Conceito</p><h2 id="title-1-1">O que é Python?</h2></div></div>
					<p>Python é uma linguagem de programação de propósito geral: usamos instruções escritas por pessoas para orientar um computador a realizar tarefas. Com ela, é possível criar programas, automatizar rotinas, analisar dados e desenvolver serviços para a web.</p>
					<p>Pense numa receita: ela descreve passos numa ordem compreensível. Um programa também reúne instruções; Python busca tornar essas instruções legíveis, para que seja mais fácil escrevê-las, revisá-las e colaborar com outras pessoas.</p>
					<div class="split-grid">
						<div class="info-card"><h3>Uma linguagem para construir</h3><p>A mesma base pode ser usada em projetos de estudo, ferramentas internas e sistemas profissionais.</p></div>
						<div class="info-card"><h3>Legibilidade como princípio</h3><p>O design valoriza código claro. O <em>Zen of Python</em> reúne princípios e ideias que ajudam a explicar essa filosofia.</p></div>
					</div>
					<p>O ecossistema inclui a biblioteca padrão, pacotes mantidos pela comunidade e ferramentas para instalar e organizar projetos. Essa combinação contribui para a popularidade da linguagem, mas a escolha de uma tecnologia depende sempre da tarefa.</p>
					<p>Como curiosidade, o interpretador interativo pode exibir o <em>Zen of Python</em> com o comando abaixo. A palavra <code>import</code> carrega recursos adicionais e será estudada mais adiante.</p>
					<CodeSample label="Curiosidade: o Zen of Python" code="import this" language="python" />
					<KeyCallout title="Você precisa saber">Python é uma linguagem de propósito geral, conhecida por favorecer a legibilidade. Você não precisa escolher uma área de atuação para começar a praticar.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-2" aria-labelledby="title-1-2">
					<div class="section-heading"><span class="section-number">1.2</span><div><p class="eyebrow"><span></span> Contexto</p><h2 id="title-1-2">Um pouco da história do Python</h2></div></div>
					<p>Python foi criado por Guido van Rossum, que buscava uma linguagem prática, extensível e agradável de ler. O nome escolhido foi uma referência ao grupo de comédia britânico Monty Python — não à cobra.</p>
					<ol class="timeline">
						<li><span>Final dos anos 1980</span><p>Van Rossum começa a trabalhar na ideia de uma nova linguagem enquanto atuava no CWI, nos Países Baixos.</p></li>
						<li><span>Dezembro de 1989</span><p>O projeto começa durante o período de recesso de fim de ano.</p></li>
						<li><span>1991</span><p>Uma primeira versão pública do Python é compartilhada.</p></li>
						<li><span>1994</span><p>Python 1.0 é lançado.</p></li>
						<li><span>2000</span><p>Python 2.0 chega com novas funcionalidades e continua a evolução da linguagem.</p></li>
						<li><span>2008</span><p>Python 3.0 é lançado. Algumas mudanças incompatíveis foram necessárias para corrigir e simplificar aspectos da linguagem; a migração levou tempo.</p></li>
						<li><span>1º de janeiro de 2020</span><p>Python 2 chega ao fim do suporte. O desenvolvimento atual da linguagem segue na linha Python 3, com participação da comunidade e da Python Software Foundation (PSF).</p></li>
					</ol>
					<KeyCallout title="Você precisa saber">Python 2 e Python 3 não são totalmente compatíveis entre si. Para aprender e iniciar projetos hoje, use uma versão compatível com Python 3.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-3" aria-labelledby="title-1-3">
					<div class="section-heading"><span class="section-number">1.3</span><div><p class="eyebrow"><span></span> Relevância</p><h2 id="title-1-3">Por que Python é tão popular?</h2></div></div>
					<p>Python combina uma sintaxe relativamente acessível com ferramentas para diferentes tipos de projeto. Isso permite que iniciantes avancem gradualmente e que equipes experientes usem a linguagem em sistemas maiores.</p>
					<ul class="feature-list">
						<li><strong>Aprendizagem gradual</strong><span>O código costuma ser legível, ajudando a manter o foco nos conceitos.</span></li>
						<li><strong>Produtividade</strong><span>É possível expressar muitas tarefas com pouco código e testar ideias rapidamente.</span></li>
						<li><strong>Comunidade e bibliotecas</strong><span>Há documentação, fóruns e pacotes que atendem a várias áreas.</span></li>
						<li><strong>Versatilidade</strong><span>A linguagem aparece em educação, automação, web, análise de dados e outros contextos.</span></li>
						<li><strong>Integração</strong><span>Projetos Python podem se comunicar com serviços e componentes escritos em outras tecnologias.</span></li>
					</ul>
					<p>Popularidade, porém, não significa que Python seja ideal para toda situação. Desempenho, ambiente de execução, requisitos de produto e experiência da equipe também importam.</p>
					<KeyCallout title="Você precisa saber">Aprender Python amplia suas opções; não existe uma linguagem que seja a melhor escolha para todos os problemas.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-4" aria-labelledby="title-1-4">
					<div class="section-heading"><span class="section-number">1.4</span><div><p class="eyebrow"><span></span> Aplicações</p><h2 id="title-1-4">Onde Python é utilizado?</h2></div></div>
					<p>Estes exemplos mostram possibilidades, não uma lista de ferramentas que você precisa estudar agora. Primeiro, vamos construir os fundamentos da linguagem.</p>
					<div class="area-grid">
						{areas.map((area, index) => (
							<article class="area-card">
								<span class="area-index">{String(index + 1).padStart(2, '0')}</span>
								<h3>{area.title}</h3>
								<p>{area.text}</p>
								<span class="area-tag">{area.tag}</span>
							</article>
						))}
					</div>
					<KeyCallout title="Sem pressa">As bibliotecas citadas são exemplos do ecossistema; você não precisa aprendê-las agora.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-5" aria-labelledby="title-1-5">
					<div class="section-heading"><span class="section-number">1.5</span><div><p class="eyebrow"><span></span> Como a linguagem funciona</p><h2 id="title-1-5">Características da linguagem</h2></div></div>
					<div class="trait-grid">
						<article class="trait-card">
							<h3>Alto nível</h3>
							<p>Uma linguagem de alto nível oferece abstrações — recursos que escondem detalhes de baixo nível — para que a pessoa pense mais na tarefa e menos em instruções específicas do processador ou no gerenciamento manual de memória.</p>
							<p>Em linguagens de baixo nível, esse controle costuma ser mais explícito. Cada abordagem serve a necessidades diferentes.</p>
						</article>
						<article class="trait-card">
							<h3>Sintaxe legível</h3>
							<p><strong>Sintaxe</strong> é o conjunto de regras que define como escrever instruções válidas. Python usa palavras e estruturas concisas:</p>
							<CodeSample label="Uma instrução simples" code={'print("Olá!")'} output="Olá!" />
						</article>
						<article class="trait-card">
							<h3>Tipagem dinâmica <span class="preview-badge">prévia</span></h3>
							<p>Os tipos são verificados durante a execução, e o tipo pertence ao valor ou objeto. A função embutida <code>type()</code> pode nos mostrar essa informação; vamos aprofundar o assunto numa próxima parte.</p>
							<CodeSample label="Observando o tipo de um valor" code="type(5)" output={"<class 'int'>"} />
						</article>
						<article class="trait-card">
							<h3>Tipagem forte</h3>
							<p>Ser dinâmica não significa que a linguagem combina tipos incompatíveis sem aviso. Em Python, tentar somar um texto com um número causa um <code>TypeError</code>, um erro de tipos.</p>
							<CodeSample label="Tipos incompatíveis" code={'"5" + 3'} />
							<p class="sample-note">Neste exemplo, a operação gera <code>TypeError</code>; Python não transforma o texto em número automaticamente.</p>
						</article>
						<article class="trait-card">
							<h3>Compilação e execução</h3>
							<p>Na implementação mais usada, CPython, o código-fonte é compilado para <strong>bytecode</strong> — uma representação intermediária — e executado pela máquina virtual do Python. Quando aplicável, o bytecode pode ser armazenado como arquivos <code>.pyc</code> em <code>__pycache__</code>.</p>
							<p>Por isso, dizer que Python é “interpretado” descreve o modelo da implementação, não uma regra absoluta da linguagem. Existem outras implementações, como PyPy.</p>
						</article>
						<article class="trait-card">
							<h3>Multiparadigma</h3>
							<p>Um <strong>paradigma</strong> é uma maneira de organizar a solução de um problema. Python permite programação procedural (sequência de instruções), orientada a objetos e funcional. Vamos conhecer essas abordagens no momento certo.</p>
						</article>
						<article class="trait-card">
							<h3>Portabilidade</h3>
							<p>O mesmo programa pode funcionar em diferentes sistemas operacionais quando há um interpretador compatível e o código não depende de recursos exclusivos de uma plataforma.</p>
						</article>
						<article class="trait-card">
							<h3>Ecossistema amplo</h3>
							<p>A biblioteca padrão acompanha Python, o PyPI é um índice de pacotes de terceiros, e <code>pip</code> é uma ferramenta comum para instalá-los. A biblioteca padrão é frequentemente descrita pela ideia de “baterias incluídas”.</p>
						</article>
					</div>
					<KeyCallout title="Você precisa saber">Python é de alto nível, dinâmica e fortemente tipada. No CPython, o código passa por bytecode antes de ser executado pela máquina virtual.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-6" aria-labelledby="title-1-6">
					<div class="section-heading"><span class="section-number">1.6</span><div><p class="eyebrow"><span></span> Mãos à obra</p><h2 id="title-1-6">Seu primeiro código Python</h2></div></div>
					<p>Vamos pedir ao programa que mostre uma saudação. O código e o resultado aparecem em blocos separados:</p>
					<CodeSample label="Olá, mundo!" code={'print("Olá, mundo!")'} output="Olá, mundo!" />
					<dl class="explanation-list">
						<div><dt><code>print()</code></dt><dd>Função embutida que exibe informações na saída do programa.</dd></div>
						<div><dt>Parênteses <code>()</code></dt><dd>Indicam a chamada da função e delimitam o argumento — neste caso, a informação enviada para ela.</dd></div>
						<div><dt><code>"Olá, mundo!"</code></dt><dd>Texto entre aspas, também chamado de <strong>string</strong>. Strings podem usar aspas simples ou duplas, desde que cada par seja fechado corretamente.</dd></div>
						<div><dt>Execução</dt><dd>O interpretador processa a instrução; <code>print()</code> envia o texto para a saída, que neste exemplo é o terminal.</dd></div>
					</dl>
					<div class="flow-card" aria-label="Etapas de execução do código">
						<span>Código-fonte</span><b aria-hidden="true">→</b><span>Interpretador</span><b aria-hidden="true">→</b><span>Saída no terminal</span>
					</div>
					<p>Você pode trocar a mensagem e executar novamente:</p>
					<CodeSample label="Outra mensagem" code={'print("Estou aprendendo Python.")'} output="Estou aprendendo Python." />
					<KeyCallout title="Você precisa saber">Em Python 3, <code>print()</code> é uma função: recebe uma informação e a exibe na saída.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-7" aria-labelledby="title-1-7">
					<div class="section-heading"><span class="section-number">1.7</span><div><p class="eyebrow"><span></span> Preparação</p><h2 id="title-1-7">Como instalar e verificar o Python</h2></div></div>
					<p>Baixe a versão estável atual de Python 3 pelo <a class="inline-link" href="https://www.python.org/downloads/" target="_blank" rel="noreferrer">site oficial</a>. A instalação varia um pouco conforme o sistema operacional:</p>
					<div class="install-grid">
						<article class="info-card"><h3>Windows</h3><p>Use o instalador oficial. Durante a instalação, a opção <strong>Add python.exe to PATH</strong> permite chamar o Python pelo terminal; o inicializador <code>py</code> também costuma estar disponível.</p></article>
						<article class="info-card"><h3>macOS</h3><p>Use o instalador oficial ou um gerenciador de pacotes. Em muitos ambientes, o comando para iniciar Python 3 é <code>python3</code>.</p></article>
						<article class="info-card"><h3>Linux</h3><p>Python 3 pode já estar disponível. Se precisar instalar, use o gerenciador de pacotes da distribuição ou consulte as instruções oficiais; <code>python3</code> é comum.</p></article>
					</div>
					<p>Abra o terminal ou prompt de comando e teste o comando correspondente à sua instalação:</p>
					<CodeSample label="Conferir a versão disponível" code={'python --version\npython3 --version\npy --version'} language="bash" />
					<p>Use <code>python --version</code> quando esse nome apontar para a instalação desejada; <code>python3 --version</code> é frequente em macOS e Linux; <code>py --version</code> é comum no Windows. Não é necessário que os três comandos funcionem no mesmo computador.</p>
					<div class="troubleshooting">
						<h3>Se o comando não for reconhecido</h3>
						<ul>
							<li>confira se a instalação terminou e reabra o terminal;</li>
							<li>no Windows, verifique se Python foi adicionado ao <code>PATH</code>, a lista de pastas onde o sistema procura programas;</li>
							<li>se houver várias versões, teste os comandos disponíveis e confirme qual delas está ativa.</li>
						</ul>
					</div>
					<p>Para escrever código, você pode usar um editor ou ambiente de desenvolvimento integrado (IDE), como VS Code, IDLE ou PyCharm. Escolha o que funciona melhor para você; nenhum deles é obrigatório para começar.</p>
				</section>

				<section class="lesson-section" id="parte-1-8" aria-labelledby="title-1-8">
					<div class="section-heading"><span class="section-number">1.8</span><div><p class="eyebrow"><span></span> Execução</p><h2 id="title-1-8">Como executar Python</h2></div></div>
					<p>O <strong>terminal</strong> — uma interface de texto para conversar com o sistema operacional — aparece como Prompt de Comando ou PowerShell no Windows e como Terminal no macOS e Linux.</p>
					<p>O comando inicial depende do sistema e da instalação. Quando um arquivo se chama <code>primeiro_programa.py</code>, você pode executá-lo assim:</p>
					<CodeSample label="Executar um arquivo Python" code={'python primeiro_programa.py'} language="bash" />
					<ol class="step-list">
						<li>O terminal localiza e chama o interpretador indicado pelo comando.</li>
						<li>O interpretador lê o arquivo e o compila para bytecode.</li>
						<li>A máquina virtual executa esse bytecode; instruções como <code>print()</code> podem mostrar resultados no terminal.</li>
					</ol>
					<p>Se a sua instalação usa outro comando, substitua <code>python</code> por <code>python3</code> ou <code>py</code>. Alguns editores oferecem um botão de execução; eles também iniciam o interpretador, embora escondam parte da configuração do terminal.</p>
					<p>Como curiosidade, é possível executar uma instrução curta sem criar arquivo:</p>
					<CodeSample label="Executar uma linha diretamente" code={'python -c "print(\'Olá\')"'} language="bash" output="Olá" />
					<KeyCallout title="Você precisa saber">Um editor não substitui Python: ele facilita escrever o código, mas um interpretador compatível ainda precisa executá-lo.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-9" aria-labelledby="title-1-9">
					<div class="section-heading"><span class="section-number">1.9</span><div><p class="eyebrow"><span></span> Exploração</p><h2 id="title-1-9">Interpretador e REPL</h2></div></div>
					<p>O <strong>interpretador</strong> é o programa que lê e executa código Python. Uma forma interativa de usá-lo é o <strong>REPL</strong>, sigla em inglês para <em>Read, Eval, Print, Loop</em>:</p>
					<dl class="repl-steps">
						<div><dt>Read</dt><dd>Lê o que você digitou.</dd></div>
						<div><dt>Eval</dt><dd>Avalia — calcula ou executa — a entrada.</dd></div>
						<div><dt>Print</dt><dd>Mostra o resultado quando há um valor a exibir.</dd></div>
						<div><dt>Loop</dt><dd>Volta ao início e aguarda outra entrada.</dd></div>
					</dl>
					<p>Inicie com o comando disponível no seu sistema: <code>python</code>, <code>python3</code> ou <code>py</code>. O prompt <code>&gt;&gt;&gt;</code> indica que o REPL está pronto para receber uma instrução.</p>
					<CodeSample label="Interação no REPL" language="text" code={'>>> 2 + 2\n4\n>>> print("Olá")\nOlá'} />
					<p>No REPL, uma expressão como <code>2 + 2</code> mostra seu resultado automaticamente. Em um arquivo <code>.py</code>, a mesma expressão não é exibida sozinha: use <code>print()</code> quando quiser mostrá-la.</p>
					<div class="split-grid">
						<div class="info-card"><h3>No REPL</h3><CodeSample label="Resultado automático" language="text" code={'>>> 2 + 2\n4'} /></div>
						<div class="info-card"><h3>Em um arquivo</h3><CodeSample label="Exibir resultado" code={'print(2 + 2)'} output="4" /></div>
					</div>
					<p>Use o REPL para experimentar instruções curtas. Para programas que deseja salvar, reutilizar ou compartilhar, prefira um arquivo.</p>
					<p>Para sair, digite <code>exit()</code>. Também é possível usar <kbd>Ctrl</kbd>+<kbd>Z</kbd> e <kbd>Enter</kbd> no Windows ou <kbd>Ctrl</kbd>+<kbd>D</kbd> no macOS e Linux.</p>
					<KeyCallout title="Você precisa saber">O REPL exibe automaticamente o resultado de expressões. Num arquivo, uma expressão isolada não aparece no terminal: use <code>print()</code>.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-10" aria-labelledby="title-1-10">
					<div class="section-heading"><span class="section-number">1.10</span><div><p class="eyebrow"><span></span> Arquivos</p><h2 id="title-1-10">Arquivos .py</h2></div></div>
					<p>Um arquivo com a extensão <code>.py</code> guarda código-fonte Python. Criar e executar um programa simples envolve estes passos:</p>
					<ol class="step-list">
						<li>Abra um editor de texto ou uma IDE.</li>
						<li>Escreva <code>print("Olá, mundo!")</code>.</li>
						<li>Salve o arquivo como <code>primeiro_programa.py</code>, usando UTF-8, uma codificação compatível com os caracteres usados em português.</li>
						<li>No terminal, navegue até a pasta do arquivo e execute <code>python primeiro_programa.py</code> — ou o comando equivalente da sua instalação.</li>
					</ol>
					<div class="table-scroll" role="region" tabindex="0" aria-label="Comparação entre o REPL e um arquivo Python">
						<table>
							<thead><tr><th scope="col">Aspecto</th><th scope="col">REPL</th><th scope="col">Arquivo .py</th></tr></thead>
							<tbody>
								<tr><th scope="row">Como usar</th><td>Digitar no prompt e receber resposta na hora.</td><td>Salvar instruções e executar o arquivo.</td></tr>
								<tr><th scope="row">Melhor para</th><td>Testar uma ideia ou explorar a linguagem.</td><td>Guardar, repetir e compartilhar um programa.</td></tr>
								<tr><th scope="row">Expressão isolada</th><td>O valor é mostrado automaticamente.</td><td>Não é mostrado sem uma instrução como <code>print()</code>.</td></tr>
							</tbody>
						</table>
					</div>
					<div class="troubleshooting">
						<h3>“Arquivo não encontrado”</h3>
						<p>O terminal procura o arquivo na pasta atual. Use <code>cd</code> para mudar de pasta, <code>dir</code> no Windows ou <code>ls</code> no macOS e Linux para conferir seu conteúdo. Depois, execute o comando na pasta correta.</p>
					</div>
					<div class="troubleshooting">
						<h3>Escolha um nome de arquivo claro</h3>
						<p>Prefira nomes simples, sem espaços nem acentos. Evite nomes que coincidam com módulos da biblioteca, como <code>random.py</code>: esse arquivo pode esconder o módulo verdadeiro quando o programa tentar carregá-lo.</p>
					</div>
				</section>

				<section class="lesson-section" id="parte-1-11" aria-labelledby="title-1-11">
					<div class="section-heading"><span class="section-number">1.11</span><div><p class="eyebrow"><span></span> Legibilidade</p><h2 id="title-1-11">Comentários</h2></div></div>
					<p>Um comentário começa com <code>#</code>. Python ignora o texto depois do símbolo até o fim da linha. Comentários podem explicar uma decisão, registrar um contexto ou desativar temporariamente uma instrução durante um teste.</p>
					<CodeSample label="Comentário em uma linha e no fim da linha" code={'# Mostra uma saudação ao iniciar\nprint("Olá!")  # A saída aparece no terminal'} output="Olá!" />
					<div class="split-grid">
						<div class="info-card"><h3>Comentário que não ajuda</h3><CodeSample label="Evite explicar o óbvio" code={'# Mostra Olá\nprint("Olá")'} /></div>
						<div class="info-card"><h3>Comentário com contexto</h3><CodeSample label="Explique a intenção" code={'# A saudação confirma que o programa iniciou.\nprint("Olá")'} /></div>
					</div>
					<p>Prefira explicar o motivo de uma escolha quando ele não for evidente. Um comentário que apenas repete a instrução pode ficar desatualizado e acrescentar pouco.</p>
					<p>Você também pode comentar uma linha para o interpretador ignorá-la temporariamente. Uma <strong>docstring</strong> — texto de documentação escrito entre aspas triplas — é usada no início de módulos ou funções; veremos seu papel com mais detalhes ao estudar funções.</p>
					<CodeSample label="Prévia de uma docstring" code={'"""Um módulo para saudar quem está aprendendo."""\nprint("Olá!")'} output="Olá!" />
					<KeyCallout title="Você precisa saber">Use comentários para registrar contexto útil, não para narrar cada linha. Docstrings documentam módulos e funções e serão retomadas mais adiante.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-12" aria-labelledby="title-1-12">
					<div class="section-heading"><span class="section-number">1.12</span><div><p class="eyebrow"><span></span> Mapa do caminho</p><h2 id="title-1-12">Primeiros conceitos fundamentais</h2></div></div>
					<p>Estes nomes aparecem com frequência quando se aprende programação. Aqui são apenas uma prévia: cada ideia será aprofundada em partes futuras.</p>
					<div class="concept-grid">
						{concepts.map((concept) => (
							<article class="concept-card">
								<h3>{concept.title}</h3>
								<p>{concept.text}</p>
								<code>{concept.example}</code>
							</article>
						))}
					</div>
					<KeyCallout title="Prévia">Os exemplos são um mapa, não uma lição completa sobre variáveis, tipos, objetos ou funções. Por enquanto, concentre-se em ler <code>print()</code>, textos e contas simples.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-13" aria-labelledby="title-1-13">
					<div class="section-heading"><span class="section-number">1.13</span><div><p class="eyebrow"><span></span> Leitura de código</p><h2 id="title-1-13">Como ler código Python</h2></div></div>
					<p>Leia cada linha de cima para baixo. Identifique o que está entre parênteses, preveja o resultado e só então execute:</p>
					<CodeSample label="Texto, número e expressão" code={'print("Daniel")\nprint(10)\nprint(10 + 5)'} output={'Daniel\n10\n15'} />
					<p><code>"Daniel"</code> é texto, enquanto <code>10</code> é um número. Em <code>10 + 5</code>, Python calcula a expressão antes de passar o resultado para <code>print()</code>.</p>
					<div class="split-grid">
						<div class="info-card"><h3>Entre aspas: texto literal</h3><CodeSample label="Os símbolos também são texto" code={'print("10 + 5")'} output="10 + 5" /></div>
						<div class="info-card"><h3>Sem aspas: operação</h3><CodeSample label="A conta é calculada" code={'print(10 + 5)'} output="15" /></div>
					</div>
					<p>Esta é uma prévia de variáveis: o nome à esquerda fica associado a um valor e pode ser usado depois. O tema será estudado em profundidade na próxima parte.</p>
					<CodeSample label="Prévia: um nome associado a um valor" code={'nome = "Daniel"\nprint(nome)'} output="Daniel" />
					<KeyCallout title="Prévia de variáveis" kind="preview">Variáveis serão estudadas em profundidade na próxima parte. Por enquanto, pense num nome que se refere a um valor; não é necessário usar variáveis nos exercícios desta parte.</KeyCallout>
					<details class="answer">
						<summary>Preveja a saída antes de abrir a resposta</summary>
						<CodeSample label="Atividade de leitura" code={'print("Resultado:")\nprint(6 + 3)'} output={'Resultado:\n9'} />
					</details>
				</section>

				<section class="lesson-section" id="parte-1-14" aria-labelledby="title-1-14">
					<div class="section-heading"><span class="section-number">1.14</span><div><p class="eyebrow"><span></span> Comparação</p><h2 id="title-1-14">Python e outras linguagens</h2></div></div>
					<p>As linguagens têm propósitos e ecossistemas diferentes. Esta tabela resume tendências gerais; implementações, ferramentas e usos variam dentro de cada linguagem.</p>
					<div class="table-scroll" role="region" tabindex="0" aria-label="Comparação de Python, JavaScript, Java, C e C++">
						<table>
							<thead><tr><th scope="col">Linguagem</th><th scope="col">Sintaxe e tipagem</th><th scope="col">Execução, em geral</th><th scope="col">Usos comuns</th></tr></thead>
							<tbody>
								<tr><th scope="row">Python</th><td>Sintaxe concisa; tipagem dinâmica e forte.</td><td>CPython compila para bytecode executado por sua máquina virtual.</td><td>Automação, web, educação e dados.</td></tr>
								<tr><th scope="row">JavaScript</th><td>Sintaxe com chaves; tipagem dinâmica e conversões em alguns contextos.</td><td>Engines executam o código e podem usar técnicas como compilação JIT.</td><td>Web no navegador e serviços no servidor.</td></tr>
								<tr><th scope="row">Java</th><td>Sintaxe mais explícita; tipagem estática.</td><td>Compila para bytecode, executado pela Java Virtual Machine (JVM).</td><td>Serviços, aplicações empresariais e Android.</td></tr>
								<tr><th scope="row">C</th><td>Sintaxe próxima à família C; tipagem estática.</td><td>Em geral, compila para código de máquina da plataforma.</td><td>Sistemas, bibliotecas e software de baixo nível.</td></tr>
								<tr><th scope="row">C++</th><td>Sintaxe extensa; tipagem estática com recursos de alto nível.</td><td>Em geral, compila para código de máquina da plataforma.</td><td>Jogos, aplicações de alto desempenho e sistemas.</td></tr>
							</tbody>
						</table>
					</div>
					<p>“Estática” e “dinâmica” descrevem quando certos tipos são verificados; o caminho de execução depende da implementação. Não há uma única resposta para qual linguagem é mais rápida ou melhor para um projeto.</p>
					<KeyCallout title="Uma escolha consciente">A escolha depende do problema, dos requisitos e da equipe — não de uma disputa entre linguagens.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-15" aria-labelledby="title-1-15">
					<div class="section-heading"><span class="section-number">1.15</span><div><p class="eyebrow"><span></span> Equilíbrio</p><h2 id="title-1-15">Vantagens e limitações</h2></div></div>
					<p>Conhecer os pontos fortes e as limitações de uma ferramenta ajuda a tomar decisões realistas.</p>
					<div class="split-grid advantage-grid">
						<article class="balance-card">
							<h3>Pontos fortes</h3>
							<ul><li>Sintaxe legível e aprendizagem gradual.</li><li>Boa produtividade para protótipos e automações.</li><li>Biblioteca padrão e ecossistema amplo.</li><li>Comunidade, documentação e aplicações variadas.</li><li>Integração com código e serviços de outras linguagens.</li></ul>
						</article>
						<article class="balance-card">
							<h3>Pontos a considerar</h3>
							<ul><li>Em tarefas muito intensivas em CPU, pode ser mais lenta que linguagens compiladas para código nativo.</li><li>O consumo de memória pode ser maior em alguns cenários.</li><li>Aplicativos mobile nativos e sistemas embarcados ou de baixo nível podem exigir outras ferramentas.</li><li>Projetos dependem da gestão de versões, ambientes e bibliotecas de terceiros.</li></ul>
						</article>
					</div>
					<p>Parte do desempenho de bibliotecas científicas vem de componentes internos escritos em linguagens como C, C++ ou Rust. Você não precisa escolher uma ferramenta hoje: aprender os fundamentos ajuda a avaliar cada contexto.</p>
					<KeyCallout title="Você precisa saber">Use Python quando suas características combinarem com o problema. Entender trade-offs é mais útil do que escolher uma linguagem por moda.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-16" aria-labelledby="title-1-16">
					<div class="section-heading"><span class="section-number">1.16</span><div><p class="eyebrow"><span></span> Depuração</p><h2 id="title-1-16">Erros comuns de iniciantes</h2></div></div>
					<p>Encontrar erros faz parte de programar. A mensagem pode apontar o tipo do problema e a linha que precisa ser investigada.</p>
					<div class="error-list">
						<article class="error-card"><h3>Aspas não fechadas</h3><p><strong>Sintoma:</strong> o texto começa, mas a string não termina com o mesmo tipo de aspas. Python informa <code>SyntaxError</code> (erro de sintaxe).</p><CodeSample label="String sem fechamento" code={'print("Olá)'} /><p><strong>Mensagem comum:</strong> <code>SyntaxError: unterminated string literal</code>; a redação pode variar entre versões.</p><p><strong>Correção:</strong> feche o texto com aspas correspondentes, por exemplo <code>print("Olá")</code>.</p></article>
						<article class="error-card"><h3>Parênteses ausentes</h3><p><strong>Sintoma:</strong> uma chamada como <code>print</code> sem seus parênteses usa sintaxe inválida em Python 3 e resulta em <code>SyntaxError</code>.</p><CodeSample label="Sintaxe inválida em Python 3" code={'print "Olá"'} /><p><strong>Mensagem comum:</strong> <code>SyntaxError: Missing parentheses in call to 'print'</code>.</p><p><strong>Correção:</strong> use <code>print("Olá")</code>.</p></article>
						<article class="error-card"><h3>Confundir <code>=</code> e <code>==</code></h3><p><strong>Sintoma:</strong> são símbolos com funções diferentes. <code>=</code> associa um valor a um nome; <code>==</code> compara valores. Comparações e variáveis serão ensinadas depois; não use isso nos exercícios desta parte.</p><CodeSample label="Prévia de uma comparação" code={'print(5 == 10)  # compara valores'} output="False" /></article>
						<article class="error-card"><h3>Maiúsculas e minúsculas</h3><p>Python diferencia letras maiúsculas de minúsculas. <code>Print</code> não é a mesma função que <code>print</code>; usar o nome incorreto pode resultar em <code>NameError</code>.</p><CodeSample label="Nome de função incorreto" code={'Print("Olá")'} /><p><strong>Mensagem comum:</strong> <code>NameError: name 'Print' is not defined</code>.</p><p><strong>Correção:</strong> escreva o nome exatamente como definido: <code>print("Olá")</code>.</p></article>
						<article class="error-card"><h3>Indentação incorreta</h3><p>Espaços à esquerda agrupam instruções em estruturas como condições e funções. Um bloco sem indentação válida causa <code>IndentationError</code>.</p><CodeSample label="Bloco sem indentação" code={'if True:\nprint("Olá")'} /><p><strong>Mensagem comum:</strong> <code>IndentationError: expected an indented block after 'if' statement</code>.</p><p><strong>Correção:</strong> coloque a instrução do bloco indentada. O tema de condições será visto depois.</p></article>
						<article class="error-card"><h3>Aspas de tipos diferentes</h3><p>Se abrir a string com aspas duplas, feche com aspas duplas; se abrir com aspas simples, feche com aspas simples.</p><CodeSample label="Aspas que não combinam" code={'print("Olá\')'} /><p><strong>Mensagem comum:</strong> <code>SyntaxError: unterminated string literal</code>.</p><p><strong>Correção:</strong> <code>print("Olá")</code> ou <code>print('Olá')</code>.</p></article>
						<article class="error-card"><h3>Executar na pasta errada</h3><p>Se o terminal não estiver na pasta do arquivo, o interpretador pode não encontrá-lo. Confira a pasta atual e use <code>cd</code> para navegar até o local correto.</p></article>
						<article class="error-card"><h3>Dar ao arquivo um nome que conflita</h3><p>Um arquivo chamado como um módulo da biblioteca, por exemplo <code>random.py</code>, pode interferir quando o programa tenta carregar esse módulo. Escolha um nome descritivo que não coincida com bibliotecas.</p></article>
						<article class="error-card"><h3>Tentar decorar tudo ou pular fundamentos</h3><p>Memorizar comandos sem entender seu efeito dificulta resolver problemas novos. Digite exemplos pequenos, modifique-os e retome os conceitos básicos quando necessário.</p></article>
						<article class="error-card"><h3>Copiar código sem entender ou depender demais de IA</h3><p>Uma resposta gerada pode estar incompleta ou errada. Peça explicações e pistas, teste o código e confirme que você consegue explicar cada trecho antes de adotá-lo.</p></article>
					</div>
					<div class="troubleshooting">
						<h3>Como ler um traceback</h3>
						<p><strong>Traceback</strong> é o relatório que Python mostra quando uma execução falha. Leia a parte final para identificar o tipo e a mensagem do erro; em seguida, confira o arquivo e a linha indicados. Se houver várias chamadas, percorra a sequência para entender como o programa chegou ao ponto da falha.</p>
					</div>
					<KeyCallout title="Uma estratégia útil" kind="note">Leia a mensagem, localize o trecho indicado e faça uma alteração por vez. Erros são informações para depurar, não uma avaliação da sua capacidade.</KeyCallout>
				</section>

				<section class="lesson-section" id="parte-1-17" aria-labelledby="title-1-17">
					<div class="section-heading"><span class="section-number">1.17</span><div><p class="eyebrow"><span></span> Método</p><h2 id="title-1-17">Como estudar Python</h2></div></div>
					<p>Combine leitura, prática e projetos pequenos. Repetir o processo com regularidade costuma ser mais sustentável do que tentar aprender tudo numa única maratona.</p>
					<div class="study-flow" aria-label="Fluxo sugerido de estudo">
						<span>Ler</span><b aria-hidden="true">→</b><span>Digitar</span><b aria-hidden="true">→</b><span>Modificar</span><b aria-hidden="true">→</b><span>Quebrar</span><b aria-hidden="true">→</b><span>Corrigir</span><b aria-hidden="true">→</b><span>Explicar</span>
					</div>
					<ul class="feature-list">
						<li><strong>Entenda os fundamentos</strong><span>Aprenda um conceito de cada vez e observe exemplos curtos.</span></li>
						<li><strong>Pratique ativamente</strong><span>Digite o exemplo em vez de apenas lê-lo; depois, altere uma parte e compare o resultado.</span></li>
						<li><strong>Leia código e mensagens de erro</strong><span>Preveja saídas, execute e use os erros para investigar o comportamento do programa.</span></li>
						<li><strong>Construa projetos pequenos</strong><span>Combine ideias já estudadas num resultado que você consiga explicar.</span></li>
					</ul>
					<div class="split-grid">
						<div class="info-card"><h3>IA como apoio</h3><p>Peça: “Explique por que este exemplo produz essa saída e me dê uma pista para resolver uma variação.”</p></div>
						<div class="info-card"><h3>Evite terceirizar a aprendizagem</h3><p>Em vez de pedir uma solução pronta para copiar, tente primeiro; depois, compare alternativas e peça que expliquem cada linha.</p></div>
					</div>
					<KeyCallout title="Você precisa saber">Entenda o código antes de aceitá-lo. Leia, digite, modifique, teste, corrija e explique a solução com suas próprias palavras.</KeyCallout>
				</section>

				<section class="lesson-section practice-section" id="pratique" aria-labelledby="title-pratique">
					<div class="section-heading"><span class="section-number">✳</span><div><p class="eyebrow"><span></span> Consolidação</p><h2 id="title-pratique">Pratique</h2></div></div>
					<p>Resolva primeiro sem abrir as soluções. Os exercícios obrigatórios usam apenas textos, números, contas simples, comentários e <code>print()</code> — não exigem variáveis.</p>
					<div class="exercise-list">
						{exercises.map((exercise, index) => (
							<article class="exercise-card">
								<div class="exercise-title"><span>{String(index + 1).padStart(2, '0')}</span><h3>{exercise.title}</h3><small>{exercise.level}</small></div>
								<p>{exercise.prompt}</p>
								<details class="hint"><summary>Ver dica</summary><p>{exercise.hint}</p></details>
