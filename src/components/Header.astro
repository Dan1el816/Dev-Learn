---
import logo from '../assets/logo.svg';
---

<header class="site-header">
	<a class="brand" href="#" aria-label="Dev Learn">
		<img class="brand-mark" src={logo.src} width="42" height="42" alt="" />
		<span class="brand-text">Dev<br />Learn</span>
	</a>
</header>

<style>
	.site-header {
		width: min(var(--content-width), calc(100% - (var(--space-page) * 2)));
		margin: 0 auto;
		padding: 28px 0 8px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}

	.brand-mark {
		width: 42px;
		height: 42px;
		border-radius: 50%;
		box-shadow: 0 0 18px rgb(155 80 255 / 45%);
	}

	.brand-text {
		color: #fff;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.15;
	}
</style>
