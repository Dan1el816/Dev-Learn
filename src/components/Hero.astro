---
import github from '../assets/social/github.svg';
import logo from '../assets/logo.svg';
---

<section class="hero">
	<div class="container hero-stage">
		<video
			class="hero-video"
			autoplay
			loop
			muted
			playsinline
			preload="auto"
			aria-hidden="true"
		>
			<source src="/Videos/coding_main3.mp4" type="video/mp4" />
		</video>
		<div class="hero-shade" aria-hidden="true"></div>
		<div class="hero-frame" aria-hidden="true"></div>

		<div class="hero-copy">
			<h1 class="hello">Hello World!</h1>
			<blockquote>
				<p class="quote">Aprenda programação praticando. Do zero ao seu primeiro projeto</p>
			</blockquote>
			<a class="cta" href="#">
				Saiba Mais
				<img src={github.src} width="22" height="22" alt="" />
			</a>
		</div>

		<div class="hero-art">
			<div class="logo-card">
				<img src={logo.src} width="240" height="160" alt="Logo do DevLearn" />
			</div>
		</div>
	</div>
	<div class="hero-rule container"></div>
</section>

<script>
	const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (heroVideo) {
		const syncMotion = () => {
			if (reducedMotion.matches) heroVideo.pause();
			else heroVideo.play().catch(() => {});
		};
		syncMotion();
		reducedMotion.addEventListener('change', syncMotion);
	}
</script>

<style>
	.hero {
		padding: 24px 0 8px;
	}

	/* ===== Palco com vídeo de fundo ===== */
	.hero-stage {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		align-items: center;
		gap: 24px;
		width: min(1360px, 95vw);
		max-width: none;
		margin-inline: auto;
		min-width: 0;
		min-height: clamp(600px, 86vh, 820px);
		padding: clamp(40px, 7vw, 96px) clamp(28px, 6vw, 88px);
		overflow: hidden;
		isolation: isolate;
		border: 1px solid rgb(192 132 252 / 26%);
		border-radius: 36px;
		background: linear-gradient(135deg, #1a1943, #0b0f24);
		box-shadow: 0 34px 70px rgb(3 5 25 / 50%), inset 0 1px 0 rgb(255 255 255 / 8%);
	}

	.hero-video {
		position: absolute;
		inset: 0;
		z-index: -3;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.03);
	}

	/* Escurece a esquerda (texto) e deixa o vídeo respirar à direita */
	.hero-shade {
		position: absolute;
		inset: 0;
		z-index: -2;
		pointer-events: none;
		background:
			linear-gradient(90deg, rgb(8 12 36 / 92%) 0%, rgb(8 12 36 / 68%) 42%, rgb(8 12 36 / 18%) 100%),
			linear-gradient(0deg, rgb(8 12 36 / 70%) 0%, transparent 38%),
			radial-gradient(circle at 85% 15%, rgb(255 79 163 / 20%), transparent 40%),
			radial-gradient(circle at 10% 90%, rgb(139 60 224 / 24%), transparent 45%);
	}

	/* Cantos em degradê, mantendo a identidade do hero anterior */
	.hero-frame {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		border-radius: 36px;
		background:
			linear-gradient(100deg, #ff75b7, #8b5cf6) top left / 30% 2px no-repeat,
			linear-gradient(100deg, #8b5cf6, #5b8cff) top right / 30% 2px no-repeat,
			linear-gradient(100deg, #ff75b7, #8b5cf6) bottom left / 30% 2px no-repeat,
			linear-gradient(100deg, #8b5cf6, #5b8cff) bottom right / 30% 2px no-repeat,
			linear-gradient(#ff75b7, #8b5cf6) top left / 2px 30% no-repeat,
			linear-gradient(#8b5cf6, #5b8cff) top right / 2px 30% no-repeat,
			linear-gradient(#ff75b7, #8b5cf6) bottom left / 2px 30% no-repeat,
			linear-gradient(#8b5cf6, #5b8cff) bottom right / 2px 30% no-repeat;
		opacity: 0.9;
		animation: frame-pulse 6s ease-in-out infinite;
	}

	@keyframes frame-pulse {
		0%,
		100% {
			opacity: 0.6;
		}
		50% {
			opacity: 1;
		}
	}

	/* ===== Texto ===== */
	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
		width: 100%;
		text-align: left;
	}

	.hello {
		width: 100%;
		max-width: 44rem;
		margin: 0 0 18px;
		background: linear-gradient(100deg, #ffffff 8%, #d6b5ff 52%, #ff75b7 100%);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
		font-size: clamp(2.8rem, 6.4vw, 5.2rem);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.035em;
		filter: drop-shadow(0 6px 24px rgb(8 12 36 / 55%));
	}

	blockquote {
		width: 100%;
		margin: 0 0 32px;
	}

	.quote {
		margin: 0;
		max-width: 34rem;
		color: #e8e8f6;
		font-size: clamp(1.15rem, 2vw, 1.55rem);
		font-weight: 500;
		line-height: 1.45;
		text-shadow: 0 2px 18px rgb(8 12 36 / 70%);
	}

	.cta {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		overflow: hidden;
		padding: 12px 26px;
		border: 1px solid rgb(255 117 183 / 45%);
		border-radius: 999px;
		background: linear-gradient(90deg, #ff4fa3 0%, #c13bff 100%);
		color: #fff;
		font-size: 1rem;
		font-weight: 600;
		box-shadow: 0 8px 24px rgb(193 59 255 / 32%);
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease,
			border-color 0.3s ease,
			background 0.3s ease;
	}

	.cta::before {
		position: absolute;
		inset: 0;
		content: '';
		background: linear-gradient(120deg, transparent 25%, rgb(255 255 255 / 45%), transparent 75%);
		transform: translateX(-130%);
		transition: transform 0.5s ease;
	}

	.cta:hover {
		border-color: #ffb3d6;
		background: linear-gradient(90deg, #ff75b7 0%, #8b3ce0 100%);
		box-shadow:
			0 0 0 4px rgb(255 79 163 / 12%),
			0 12px 28px rgb(255 79 163 / 42%);
		transform: translateY(-4px) scale(1.04);
	}

	.cta:hover::before {
		transform: translateX(130%);
	}

	.cta img {
		position: relative;
		z-index: 1;
		width: 22px;
		height: 22px;
		filter: brightness(0) invert(1);
		transition: transform 0.3s ease;
	}

	.cta:hover img {
		transform: translateX(4px) rotate(8deg);
	}

	.cta:focus-visible {
		outline: 3px solid rgb(255 117 183 / 55%);
		outline-offset: 4px;
	}

	/* ===== Logo em card de vidro ===== */
	.hero-art {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
		width: 100%;
	}

	.logo-card {
		display: grid;
		place-items: center;
		padding: clamp(20px, 3.5vw, 36px);
		border: 1px solid rgb(255 255 255 / 16%);
		border-radius: 28px;
		background: rgb(15 20 50 / 38%);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow:
			0 24px 50px rgb(3 5 25 / 40%),
			inset 0 1px 0 rgb(255 255 255 / 12%);
		animation: card-float 5s ease-in-out infinite;
	}

	.logo-card img {
		display: block;
		width: 240px;
		height: 160px;
		max-width: 100%;
		object-fit: contain;
		filter: drop-shadow(0 0 14px rgb(255 79 163 / 32%)) drop-shadow(0 0 22px rgb(53 183 255 / 20%));
	}

	@keyframes card-float {
		0%,
		100% {
			transform: translate3d(0, -3px, 0);
		}
		50% {
			transform: translate3d(4px, -12px, 0);
		}
	}

	.hero-rule {
		width: min(1360px, 95vw);
		max-width: none;
		margin-inline: auto;
		height: 2px;
		margin-top: 28px;
		background: linear-gradient(90deg, transparent, #7c5cff 20%, #5b8cff 80%, transparent);
		opacity: 0.9;
	}

	/* ===== Responsivo ===== */
	@media (max-width: 860px) {
		.hero-stage {
			grid-template-columns: 1fr;
			min-height: 560px;
			padding: 44px clamp(18px, 5vw, 32px) 48px;
			text-align: center;
		}

		.hero-shade {
			background:
				linear-gradient(0deg, rgb(8 12 36 / 90%) 0%, rgb(8 12 36 / 62%) 55%, rgb(8 12 36 / 40%) 100%),
				radial-gradient(circle at 85% 10%, rgb(255 79 163 / 20%), transparent 40%);
		}

		.hero-art {
			order: -1;
		}

		.logo-card img {
			width: 180px;
			height: 120px;
		}

		.hero-copy {
			align-items: center;
			text-align: center;
		}
	}

	@media (max-width: 520px) {
		.hero-stage {
			border-radius: 26px;
		}

		.hero-frame {
			border-radius: 26px;
		}

		.cta {
			width: 100%;
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-frame,
		.logo-card {
			animation: none;
		}

		.cta,
		.cta::before,
		.cta img {
			transition: none;
		}
	}
</style>