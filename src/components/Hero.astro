---
import computer from '../assets/illustrations/computer.svg';
import github from '../assets/social/github.svg';
---

<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<h1 class="hello">Hello World!</h1>
			<blockquote>
				<p class="quote">O verdadeiro valor do conhecimento aparece quando o colocamos em prática.</p>
				<cite>Confúcio</cite>
			</blockquote>
			<a class="cta" href="#">
				Saiba Mais
				<img src={github.src} width="22" height="22" alt="" />
			</a>
		</div>
		<div class="hero-art">
			<img src={computer.src} width="520" height="360" alt="Computador com código e ícones de tecnologia" />
		</div>
	</div>
	<div class="hero-rule container"></div>
</section>

<style>
	.hero {
		padding: 24px 0 8px;
	}

	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		align-items: center;
		gap: 24px;
		min-width: 0;
		padding: clamp(32px, 6vw, 64px) clamp(20px, 5vw, 56px);
		border-radius: 36px;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 0;
		text-align: center;
		isolation: isolate;
		width: 100%;
	}

	.hero-grid::before,
	.hero-grid::after {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		content: '';
	}

	.hero-grid::before {
		border: 1px solid transparent;
		border-radius: 36px;
		background:
			linear-gradient(100deg, #ff75b7, #8b5cf6) top left / 34% 1px no-repeat,
			linear-gradient(100deg, #8b5cf6, #5b8cff) top right / 34% 1px no-repeat,
			linear-gradient(100deg, #ff75b7, #8b5cf6) bottom left / 34% 1px no-repeat,
			linear-gradient(100deg, #8b5cf6, #5b8cff) bottom right / 34% 1px no-repeat,
			linear-gradient(#ff75b7, #8b5cf6) top left / 1px 34% no-repeat,
			linear-gradient(#8b5cf6, #5b8cff) top right / 1px 34% no-repeat,
			linear-gradient(#ff75b7, #8b5cf6) bottom left / 1px 34% no-repeat,
			linear-gradient(#8b5cf6, #5b8cff) bottom right / 1px 34% no-repeat;
		filter: drop-shadow(0 0 12px rgb(139 92 246 / 34%));
		animation: hero-frame-glow 5s ease-in-out infinite, hero-frame-drift 9s ease-in-out infinite;
	}

	.hero-grid::after {
		inset: 22px 24px;
		border-radius: 26px;
		background:
			radial-gradient(circle, rgb(255 117 183 / 55%) 0 1px, transparent 1.5px) top right / 56px 56px no-repeat,
			linear-gradient(90deg, rgb(91 140 255 / 30%), transparent) top right / 110px 1px no-repeat,
			linear-gradient(180deg, rgb(255 117 183 / 25%), transparent) top right / 1px 110px no-repeat,
			linear-gradient(90deg, transparent, rgb(139 92 246 / 38%), transparent) bottom left / 150px 1px no-repeat,
			linear-gradient(0deg, transparent, rgb(91 140 255 / 32%), transparent) bottom left / 1px 92px no-repeat;
		opacity: 0.7;
		animation: hero-tech-scan 7s ease-in-out infinite;
	}

	.hero-grid > * {
		position: relative;
		z-index: 1;
	}

	@keyframes hero-frame-glow {
		0%,
		100% {
			opacity: 0.72;
		}
		50% {
			opacity: 1;
		}
	}

	@keyframes hero-frame-drift {
		0%,
		100% {
			transform: scale(0.996);
		}
		50% {
			transform: scale(1.004);
		}
	}

	@keyframes hero-tech-scan {
		0%,
		100% {
			transform: translate(0, 0);
			opacity: 0.55;
		}
		50% {
			transform: translate(8px, -5px);
			opacity: 0.9;
		}
	}

	.hello {
		width: 100%;
		max-width: 44rem;
		margin: 0 0 18px;
		background: linear-gradient(100deg, #ffffff 8%, #d6b5ff 52%, #ff75b7 100%);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
		font-size: clamp(2.8rem, 6vw, 4.7rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	blockquote {
		width: 100%;
		margin: 0 0 28px;
	}

	.quote {
		margin: 0;
		max-width: 48rem;
		background: linear-gradient(100deg, #ffffff 8%, #d6b5ff 52%, #ff75b7 100%);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
		font-size: clamp(1.75rem, 3.2vw, 2.55rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	cite {
		display: block;
		margin-top: 10px;
		color: #cfcfe6;
		font-size: 0.95rem;
		font-style: italic;
		font-weight: 400;
		text-align: center;
		max-width: 40rem;
	}

	.cta {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		overflow: hidden;
		padding: 10px 22px;
		border: 1px solid rgb(255 117 183 / 45%);
		border-radius: 999px;
		background: linear-gradient(90deg, #ff4fa3 0%, #c13bff 100%);
		color: #fff;
		font-size: 0.95rem;
		font-weight: 600;
		box-shadow: 0 8px 24px rgb(193 59 255 / 28%);
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease,
			border-color 0.3s ease,
			background 0.3s ease;
	}

	.cta::before {
		position: absolute;
		inset: 0;
		content: '';
		background: linear-gradient(120deg, transparent 25%, rgb(255 255 255 / 45%), transparent 75%);
		transform: translateX(-130%);
		transition: transform 0.5s ease;
	}

	.cta:hover {
		border-color: #ffb3d6;
		background: linear-gradient(90deg, #ff75b7 0%, #8b3ce0 100%);
		box-shadow:
			0 0 0 4px rgb(255 79 163 / 12%),
			0 12px 28px rgb(255 79 163 / 42%);
		transform: translateY(-4px) scale(1.04);
	}

	.cta:hover::before {
		transform: translateX(130%);
	}

	.cta img {
		position: relative;
		z-index: 1;
		width: 22px;
		height: 22px;
		filter: brightness(0) invert(1);
		transition: transform 0.3s ease;
	}

	.cta:hover img {
		transform: translateX(4px) rotate(8deg);
	}

	.cta:focus-visible {
		outline: 3px solid rgb(255 117 183 / 55%);
		outline-offset: 4px;
	}

	.hero-art {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
		min-width: 0;
		width: 100%;
		isolation: isolate;
		padding: clamp(18px, 4vw, 34px);
	}

	.hero-art::before,
	.hero-art::after {
		position: absolute;
		pointer-events: none;
		content: '';
	}

	.hero-art::before {
		inset: 8px;
		z-index: -2;
		border: 1px solid rgb(139 92 246 / 34%);
		border-radius: 30px;
		background:
			radial-gradient(circle at 72% 24%, rgb(255 117 183 / 24%), transparent 32%),
			linear-gradient(145deg, rgb(91 140 255 / 14%), rgb(139 92 246 / 8%) 48%, rgb(255 117 183 / 12%));
		box-shadow:
			inset 0 1px rgb(255 255 255 / 10%),
			0 20px 50px rgb(28 15 92 / 30%);
		transform: rotate(1.5deg);
	}

	.hero-art::after {
		inset: 22px 18px;
		z-index: -1;
		border-radius: 22px;
		background:
			linear-gradient(90deg, rgb(255 117 183 / 42%) 0 16px, transparent 16px 100%) top left / 100% 1px no-repeat,
			linear-gradient(90deg, transparent calc(100% - 16px), rgb(91 140 255 / 42%) calc(100% - 16px)) bottom right / 100% 1px no-repeat,
			radial-gradient(circle, rgb(255 255 255 / 24%) 0 1px, transparent 1.5px) 12px 12px / 34px 34px;
		opacity: 0.7;
	}

	.hero-art img {
		position: relative;
		width: min(100%, 540px);
		height: auto;
		filter: drop-shadow(0 18px 30px rgb(41 26 142 / 28%));
		transform: translateY(-3px);
		animation: hero-art-float 5s ease-in-out infinite;
		transition: transform 0.35s ease, filter 0.35s ease;
	}

	.hero-art:hover img {
		animation-play-state: paused;
		filter: drop-shadow(0 22px 34px rgb(41 26 142 / 42%));
		transform: translateY(-7px) scale(1.015);
	}

	@keyframes hero-art-float {
		0%,
		100% {
			filter: drop-shadow(0 18px 30px rgb(41 26 142 / 28%));
			transform: translate3d(0, -3px, 0);
		}
		50% {
			filter: drop-shadow(2px 21px 32px rgb(41 26 142 / 34%));
			transform: translate3d(4px, -10px, 0);
		}
	}

	.hero-rule {
		height: 2px;
		margin-top: 28px;
		background: linear-gradient(90deg, transparent, #7c5cff 20%, #5b8cff 80%, transparent);
		opacity: 0.9;
	}

	@media (max-width: 860px) {
		.hero-grid {
			grid-template-columns: 1fr;
			min-height: 0;
			padding-inline: clamp(16px, 5vw, 32px);
		}

		.hero-art {
			order: -1;
			margin-bottom: -8px;
			padding-inline: clamp(8px, 5vw, 28px);
		}

		cite {
			text-align: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-grid::before,
		.hero-grid::after {
			animation: none;
		}

		.hero-art img {
			animation: none;
			transition: none;
			transform: none;
		}
	}
</style>
