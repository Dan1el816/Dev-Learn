---
import computer from '../assets/illustrations/computer.svg';
import github from '../assets/social/github.svg';
---

<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="hello">Hello World!</p>
			<blockquote>
				<p class="quote">A Essência do conhecimento consiste em aplica-lo, uma vez possuído</p>
				<cite>Confúcio</cite>
			</blockquote>
			<a class="cta" href="#">
				Saiba Mais
				<img src={github.src} width="22" height="22" alt="" />
			</a>
		</div>
		<div class="hero-art">
			<img src={computer.src} width="520" height="360" alt="Computador com código e ícones de tecnologia" />
		</div>
	</div>
	<div class="hero-rule container"></div>
</section>

<style>
	.hero {
		padding: 24px 0 8px;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: center;
		gap: 24px;
		min-height: 410px;
	}

	.hello {
		margin: 0 0 10px;
		color: #fff;
		font-size: clamp(1.7rem, 3vw, 2.15rem);
		font-weight: 700;
		line-height: 1.2;
	}

	blockquote {
		margin: 0 0 28px;
	}

	.quote {
		margin: 0;
		max-width: 34rem;
		color: #fff;
		font-size: clamp(1.45rem, 2.6vw, 2.05rem);
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.03em;
	}

	cite {
		display: block;
		margin-top: 10px;
		color: #cfcfe6;
		font-size: 0.95rem;
		font-style: italic;
		font-weight: 400;
		text-align: right;
		max-width: 34rem;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 10px 22px;
		border-radius: 999px;
		background: linear-gradient(90deg, #ff4fa3 0%, #c13bff 100%);
		color: #fff;
		font-size: 0.95rem;
		font-weight: 600;
		box-shadow: 0 8px 24px rgb(193 59 255 / 28%);
	}

	.cta img {
		width: 22px;
		height: 22px;
		filter: brightness(0) invert(1);
	}

	.hero-art {
		display: grid;
		place-items: center;
	}

	.hero-art img {
		width: min(100%, 540px);
		height: auto;
		filter: drop-shadow(0 18px 30px rgb(41 26 142 / 28%));
	}

	.hero-rule {
		height: 2px;
		margin-top: 28px;
		background: linear-gradient(90deg, transparent, #7c5cff 20%, #5b8cff 80%, transparent);
		opacity: 0.9;
	}

	@media (max-width: 860px) {
		.hero-grid {
			grid-template-columns: 1fr;
			min-height: 0;
		}

		.hero-art {
			order: -1;
			margin-bottom: -8px;
		}

		cite {
			text-align: left;
		}
	}
</style>
