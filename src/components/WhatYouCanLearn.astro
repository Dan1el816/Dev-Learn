---
import python from '../assets/icons/python.svg';
import database from '../assets/icons/database.svg';
import calculus from '../assets/icons/calculus.svg';
import oop from '../assets/icons/oop.svg';
import git from '../assets/icons/git.svg';
import rocket from '../assets/icons/rocket.svg';

// O caminho '/linguagens' redireciona automaticamente para o arquivo src/pages/linguagens.astro
const topics = [
	{ label: 'Linguagens', icon: python, href: '/linguagens' },
	{ label: 'Estrutura de dados', icon: database },
	{ label: 'Cálculo', icon: calculus },
	{ label: 'POO', icon: oop },
	{ label: 'Git e GitHub', icon: git },
];

const comingSoon = Array.from({ length: 5 }, () => ({
	label: 'Em Breve...',
	icon: rocket,
}));
---

<section class="learn">
	<div class="container">
		<h2>O Que você pode Aprender</h2>
		<div class="panel">
			<div class="grid">
				{
					[...topics, ...comingSoon].map((item) => {
						const Element = item.href ? 'a' : 'article';
						return (
							<Element href={item.href} class="card">
								<img src={item.icon.src} width="56" height="56" alt="" />
								<p>{item.label}</p>
							</Element>
						);
					})
				}
			</div>
		</div>
	</div>
</section>

<style>
	.learn {
		padding: 72px 0 34px;
	}

	h2 {
		margin: 0 0 22px;
		color: #c084fc;
		font-size: clamp(1.45rem, 2.4vw, 1.85rem);
		font-weight: 700;
		text-align: center;
	}

	.panel {
		position: relative;
		overflow: hidden;
		padding: 30px 28px;
		border: 1px solid rgb(192 132 252 / 24%);
		border-radius: 24px;
		background: linear-gradient(135deg, #11152f 0%, #0d1228 52%, #101936 100%);
		box-shadow: 0 18px 40px rgb(2 4 22 / 38%), inset 0 1px 0 rgb(255 255 255 / 6%);
		isolation: isolate;
	}

	/* Antes: animava background-position no elemento inteiro (repaint constante).
	   Agora: um pseudo-elemento maior que só se move com transform (GPU-friendly). */
	.panel::before {
		position: absolute;
		inset: -20%;
		z-index: -1;
		content: '';
		background: radial-gradient(circle at 30% 30%, rgb(139 60 224 / 22%), transparent 40%);
		will-change: transform;
		animation: learn-panel-drift 18s ease-in-out infinite alternate;
	}

	@keyframes learn-panel-drift {
		0% {
			transform: translate3d(0, 0, 0);
		}
		100% {
			transform: translate3d(6%, 4%, 0);
		}
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 18px;
	}

	.card {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-height: 138px;
		padding: 16px 10px;
		border: 1px solid rgb(255 255 255 / 14%);
		border-radius: 16px;
		background: linear-gradient(180deg, rgb(255 255 255 / 18%), rgb(40 20 140 / 22%));
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 18%);
		text-align: center;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
		isolation: isolate;
		text-decoration: none; /* Remove a linha de sublinhado do link */
	}

	.card::before {
		position: absolute;
		inset: -40%;
		z-index: -1;
		content: '';
		background: radial-gradient(circle, rgb(255 79 163 / 42%), transparent 62%);
		opacity: 0;
		transform: scale(0.7);
		transition: opacity 0.3s ease, transform 0.4s ease;
	}

	.card::after {
		position: absolute;
		right: 18%;
		bottom: 0;
		left: 18%;
		height: 3px;
		content: '';
		border-radius: 3px 3px 0 0;
		background: linear-gradient(90deg, #ff4fa3, #c084fc);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 0.3s ease;
	}

	.card:hover {
		border-color: rgb(255 255 255 / 48%);
		background: linear-gradient(180deg, rgb(255 255 255 / 28%), rgb(49 27 154 / 38%));
		box-shadow: 0 16px 28px rgb(18 10 90 / 28%), inset 0 1px 0 rgb(255 255 255 / 28%);
		transform: translateY(-8px) scale(1.025);
	}

	.card:hover::before {
		opacity: 1;
		transform: scale(1);
	}

	.card:hover::after {
		transform: scaleX(1);
	}

	.card img {
		width: 52px;
		height: 52px;
		transition: transform 0.3s ease, filter 0.3s ease;
	}

	.card:hover img {
		filter: drop-shadow(0 0 10px rgb(255 255 255 / 42%));
		transform: translateY(-4px) rotate(-4deg) scale(1.08);
	}

	.card p {
		margin: 0;
		color: #fff;
		font-size: 0.82rem;
		font-weight: 500;
		line-height: 1.25;
	}

	@media (prefers-reduced-motion: reduce) {
		.panel::before {
			animation: none;
		}

		.card,
		.card::before,
		.card::after,
		.card img {
			transition: none;
			animation: none;
		}
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.panel {
			padding: 18px 14px;
		}

		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 12px;
		}
	}
</style>