---
import python from '../assets/icons/python.svg';
import database from '../assets/icons/database.svg';
import calculus from '../assets/icons/calculus.svg';
import oop from '../assets/icons/oop.svg';
import git from '../assets/icons/git.svg';
import rocket from '../assets/icons/rocket.svg';

const topics = [
	{ label: 'Linguagens', icon: python },
	{ label: 'Estrutura de dados', icon: database },
	{ label: 'Cálculo', icon: calculus },
	{ label: 'POO', icon: oop },
	{ label: 'Git e GitHub', icon: git },
];

const comingSoon = Array.from({ length: 5 }, () => ({
	label: 'Em Breve...',
	icon: rocket,
}));
---

<section class="learn">
	<div class="container">
		<h2>O Que você pode Aprender</h2>
		<div class="panel">
			<div class="grid">
				{[...topics, ...comingSoon].map((item) => (
					<article class="card">
						<img src={item.icon.src} width="56" height="56" alt="" />
						<p>{item.label}</p>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.learn {
		padding: 72px 0 34px;
	}

	h2 {
		margin: 0 0 22px;
		color: #c084fc;
		font-size: clamp(1.45rem, 2.4vw, 1.85rem);
		font-weight: 700;
	}

	.panel {
		padding: 30px 28px;
		border: 1px solid rgb(202 192 255 / 22%);
		border-radius: 24px;
		background:
			radial-gradient(circle at 12% 0%, rgb(211 119 255 / 42%), transparent 38%),
			linear-gradient(135deg, #754dff 0%, #5145d5 52%, #245fd0 100%);
		box-shadow: 0 18px 40px rgb(37 99 235 / 18%);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 18px;
	}

	.card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-height: 138px;
		padding: 16px 10px;
		border: 1px solid rgb(255 255 255 / 14%);
		border-radius: 16px;
		background: linear-gradient(180deg, rgb(255 255 255 / 18%), rgb(40 20 140 / 22%));
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 18%);
		text-align: center;
	}

	.card img {
		width: 52px;
		height: 52px;
	}

	.card p {
		margin: 0;
		color: #fff;
		font-size: 0.82rem;
		font-weight: 500;
		line-height: 1.25;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.panel {
			padding: 18px 14px;
		}

		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 12px;
		}
	}
</style>
