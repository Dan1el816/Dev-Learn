---
import python from '../assets/icons/python.svg';
import database from '../assets/icons/database.svg';
import calculus from '../assets/icons/calculus.svg';
import oop from '../assets/icons/oop.svg';
import git from '../assets/icons/git.svg';
import rocket from '../assets/icons/rocket.svg';

// O caminho '/linguagens' redireciona automaticamente para o arquivo src/pages/linguagens.astro
const topics = [
	{ label: 'Linguagens', descricao: 'HTML, CSS, JS e mais', icon: python, href: '/linguagens', cor: '#facc15', disponivel: true },
	{ label: 'Estrutura de dados', descricao: 'Organize e otimize', icon: database, cor: '#38bdf8', disponivel: true },
	{ label: 'Cálculo', descricao: 'Lógica matemática', icon: calculus, cor: '#22c55e', disponivel: true },
	{ label: 'POO', descricao: 'Programação orientada a objetos', icon: oop, cor: '#a855f7', disponivel: true },
	{ label: 'Git e GitHub', descricao: 'Versione seus projetos', icon: git, cor: '#f97316', disponivel: true },
];

const comingSoon = Array.from({ length: 5 }, () => ({
	label: 'Em Breve...',
	descricao: 'Nova trilha chegando',
	icon: rocket,
	cor: '#ff4fa3',
	disponivel: false,
}));

const allTopics = [...topics, ...comingSoon];
---

<section class="learn">
	<div class="container">
		<div class="section-heading">
			<h2>O que você pode aprender</h2>
			<p class="learn-lead">Trilhas pensadas pra levar você da teoria à prática, uma habilidade de cada vez.</p>
		</div>

		<div class="panel">
			<div class="grid">
				{
					allTopics.map((item) => {
						const Element = item.href ? 'a' : 'article';
						return (
							<Element
								href={item.href}
								class={`card ${item.disponivel ? '' : 'is-coming-soon'}`}
								aria-disabled={!item.disponivel}
								style={`--topic-color: ${item.cor}`}
							>
								<span class="card-glow" aria-hidden="true"></span>
								<span class={`card-badge ${item.disponivel ? 'is-available' : ''}`}>
									{item.disponivel ? 'Disponível' : 'Em breve'}
								</span>
								<span class="card-icon">
									<img src={item.icon.src} width="40" height="40" alt="" />
								</span>
								<div class="card-copy">
									<p class="card-title">{item.label}</p>
									<p class="card-desc">{item.descricao}</p>
								</div>
								{item.disponivel && (
									<span class="card-arrow" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path d="M5 12h13M13 6l6 6-6 6" />
										</svg>
									</span>
								)}
							</Element>
						);
					})
				}
			</div>
		</div>
	</div>
</section>

<style>
	.learn {
		padding: 72px 0 34px;
	}

	.section-heading {
		max-width: 42rem;
		margin: 0 auto 30px;
		text-align: center;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 9px;
		margin: 0 0 12px;
		color: #c084fc;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.eyebrow span {
		width: 24px;
		height: 2px;
		background: linear-gradient(90deg, #ff4fa3, #9b32ff);
	}

	.section-heading h2 {
		margin: 0;
		background: linear-gradient(100deg, #ffffff 8%, #d6b5ff 52%, #ff75b7 100%);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
		font-size: clamp(1.75rem, 3.2vw, 2.55rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.learn-lead {
		margin: 12px 0 0;
		color: #b7b9c9;
		font-size: 0.98rem;
		line-height: 1.6;
	}

	.panel {
		position: relative;
		overflow: hidden;
		padding: 30px 28px;
		border: 1px solid rgb(192 132 252 / 24%);
		border-radius: 24px;
		background: linear-gradient(135deg, #11152f 0%, #0d1228 52%, #101936 100%);
		box-shadow: 0 18px 40px rgb(2 4 22 / 38%), inset 0 1px 0 rgb(255 255 255 / 6%);
		isolation: isolate;
	}

	.panel::before {
		position: absolute;
		inset: -20%;
		z-index: -1;
		content: '';
		background: radial-gradient(circle at 30% 30%, rgb(139 60 224 / 22%), transparent 40%);
		will-change: transform;
		animation: learn-panel-drift 18s ease-in-out infinite alternate;
	}

	@keyframes learn-panel-drift {
		0% {
			transform: translate3d(0, 0, 0);
		}
		100% {
			transform: translate3d(6%, 4%, 0);
		}
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 18px;
	}

	.card {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
		min-height: 178px;
		padding: 18px 18px 20px;
		border: 1px solid rgb(255 255 255 / 14%);
		border-radius: 16px;
		background: linear-gradient(180deg, rgb(255 255 255 / 10%), rgb(40 20 140 / 22%));
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 18%);
		text-align: left;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
		isolation: isolate;
		text-decoration: none;
	}

	.card-glow {
		position: absolute;
		inset: -40%;
		z-index: -1;
		background: radial-gradient(circle, color-mix(in srgb, var(--topic-color), transparent 40%), transparent 62%);
		opacity: 0;
		transform: scale(0.7);
		transition: opacity 0.3s ease, transform 0.4s ease;
	}

	.card::after {
		position: absolute;
		right: 18%;
		bottom: 0;
		left: 18%;
		height: 3px;
		content: '';
		border-radius: 3px 3px 0 0;
		background: var(--topic-color);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 0.3s ease;
	}

	.card:hover {
		border-color: color-mix(in srgb, var(--topic-color), white 20%);
		background: linear-gradient(180deg, rgb(255 255 255 / 16%), rgb(49 27 154 / 38%));
		box-shadow: 0 16px 28px rgb(18 10 90 / 28%), inset 0 1px 0 rgb(255 255 255 / 28%);
		transform: translateY(-8px) scale(1.02);
	}

	.card:hover .card-glow {
		opacity: 1;
		transform: scale(1);
	}

	.card:hover::after {
		transform: scaleX(1);
	}

	.card.is-coming-soon {
		cursor: default;
		opacity: 0.68;
	}

	.card.is-coming-soon:hover {
		opacity: 0.85;
		transform: translateY(-3px);
		box-shadow: none;
	}

	.card-badge {
		align-self: flex-start;
		padding: 4px 10px;
		border: 1px solid rgb(255 255 255 / 18%);
		border-radius: 999px;
		background: rgb(255 255 255 / 6%);
		color: #b7b9c9;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.card-badge.is-available {
		border-color: color-mix(in srgb, var(--topic-color), transparent 30%);
		background: color-mix(in srgb, var(--topic-color), transparent 82%);
		color: var(--topic-color);
	}

	.card-icon {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 14px;
		background: color-mix(in srgb, var(--topic-color), transparent 78%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 14%);
		transition: transform 0.3s ease, background 0.3s ease;
	}

	.card:hover .card-icon {
		background: color-mix(in srgb, var(--topic-color), transparent 60%);
		transform: translateY(-2px) rotate(-4deg) scale(1.06);
	}

	.card-icon img {
		width: 28px;
		height: 28px;
		filter: drop-shadow(0 0 6px rgb(255 255 255 / 25%));
	}

	.card-copy {
		margin-top: auto;
	}

	.card-title {
		margin: 0 0 4px;
		color: #fff;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.card-desc {
		margin: 0;
		color: #9a9bb0;
		font-size: 0.76rem;
		line-height: 1.4;
	}

	.card-arrow {
		position: absolute;
		top: 16px;
		right: 16px;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border: 1px solid rgb(255 255 255 / 16%);
		border-radius: 50%;
		color: #b7b9c9;
		opacity: 0;
		transform: translate(-4px, 4px);
		transition: opacity 0.25s ease, transform 0.25s ease, color 0.25s ease, border-color 0.25s ease;
	}

	.card-arrow svg {
		width: 13px;
		height: 13px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.card:hover .card-arrow {
		border-color: var(--topic-color);
		color: var(--topic-color);
		opacity: 1;
		transform: translate(0, 0);
	}

	.card:focus-visible {
		outline: 3px solid rgb(255 117 183 / 55%);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.panel::before {
			animation: none;
		}

		.card,
		.card-glow,
		.card::after,
		.card-icon,
		.card-arrow {
			transition: none;
			animation: none;
		}
	}

	@media (max-width: 1080px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.panel {
			padding: 18px 14px;
		}

		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 12px;
		}

		.card {
			min-height: 160px;
			padding: 14px 14px 16px;
		}
	}

	@media (max-width: 380px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>