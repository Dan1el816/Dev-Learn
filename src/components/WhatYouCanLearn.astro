---
import python from '../assets/icons/python.svg';
import database from '../assets/icons/database.svg';
import calculus from '../assets/icons/calculus.svg';
import oop from '../assets/icons/oop.svg';
import git from '../assets/icons/git.svg';
import rocket from '../assets/icons/rocket.svg';

const topics = [
	{
		label: 'Linguagens',
		descricao: 'HTML, CSS, JS e mais',
		icon: python,
		href: '/linguagens',
		cor: '#facc15',
		disponivel: true,
	},
	{
		label: 'Estrutura de dados',
		descricao: 'Organize e otimize',
		icon: database,
		cor: '#38bdf8',
		disponivel: true,
	},
	{
		label: 'Cálculo',
		descricao: 'Lógica matemática',
		icon: calculus,
		cor: '#22c55e',
		disponivel: true,
	},
	{
		label: 'POO',
		descricao: 'Programação orientada a objetos',
		icon: oop,
		cor: '#a855f7',
		disponivel: true,
	},
	{
		label: 'Git e GitHub',
		descricao: 'Versione seus projetos',
		icon: git,
		cor: '#f97316',
		disponivel: true,
	},
];

const comingSoon = Array.from({ length: 5 }, () => ({
	label: 'Em Breve...',
	descricao: 'Nova trilha chegando',
	icon: rocket,
	cor: '#ff4fa3',
	disponivel: false,
}));

const allTopics = [...topics, ...comingSoon];

const journey = [
	{
		label: 'HTML & CSS',
		icon: '01',
	},
	{
		label: 'JavaScript',
		icon: '02',
	},
	{
		label: 'React',
		icon: '03',
	},
	{
		label: 'Git & GitHub',
		icon: '04',
	},
	{
		label: 'Projeto',
		icon: '05',
	},
];
---

<section class="learn">
	<div class="container">
		<div class="section-heading">

			<h2>O que você pode aprender</h2>

			<p class="learn-lead">
				Trilhas pensadas pra levar você da teoria à prática,
				uma habilidade de cada vez.
			</p>
		</div>

		<div class="panel">

			<!-- =========================
			     CARDS
			========================= -->

			<div class="grid">
				{
					allTopics.map((item) => {
						const Element = item.href ? 'a' : 'article';

						return (
							<Element
								href={item.href}
								class={`card ${item.disponivel ? '' : 'is-coming-soon'}`}
								aria-disabled={!item.disponivel}
								style={`--topic-color: ${item.cor}`}
							>
								<span class="card-glow" aria-hidden="true"></span>

								<span
									class={`card-badge ${
										item.disponivel ? 'is-available' : ''
									}`}
								>
									{item.disponivel ? 'Disponível' : 'Em breve'}
								</span>

								<span class="card-icon">
									<img
										src={item.icon.src}
										width="40"
										height="40"
										alt=""
									/>
								</span>

								<div class="card-copy">
									<p class="card-title">{item.label}</p>

									<p class="card-desc">
										{item.descricao}
									</p>
								</div>

								{item.disponivel && (
									<span
										class="card-arrow"
										aria-hidden="true"
									>
										<svg viewBox="0 0 24 24">
											<path d="M5 12h13M13 6l6 6-6 6" />
										</svg>
									</span>
								)}
							</Element>
						);
					})
				}
			</div>

			<!-- =========================
			     TRANSIÇÃO PARA A PRÁTICA
			========================= -->

			<div class="practice-heading">

				<h3>O que você vai conseguir fazer</h3>

				<p>
					Aprenda os fundamentos, conecte as habilidades e transforme
					o conhecimento em projetos reais.
				</p>
			</div>


			<!-- =========================
			     VÍDEO 1
			========================= -->

			<div class="video-showcase">
				<div class="video-frame">

					<div class="video-topbar" aria-hidden="true">
						<div class="window-dots">
							<span></span>
							<span></span>
							<span></span>
						</div>

						<div class="video-title">
							<span class="status-dot"></span>
							DevLearn — Coding
						</div>

						<div class="video-status">
							<span></span>
							Em execução
						</div>
					</div>

					<div class="video-content">

						<video
							class="coding-video"
							autoplay
							loop
							muted
							playsinline
							preload="metadata"
							aria-label="Demonstração de programação no DevLearn"
						>
							<source
								src="/public/Videos/coding.mp4"
								type="video/mp4"
							/>

							Seu navegador não suporta vídeos HTML5.
						</video>

						<div
							class="video-overlay"
							aria-hidden="true"
						></div>

						<div class="video-caption">
							<div class="caption-line"></div>

							<div>
								<span>DO APRENDIZADO</span>
								<strong>PARA O CÓDIGO</strong>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- =========================
			     TEXTO DE TRANSIÇÃO ENTRE OS VÍDEOS
			========================= -->

			<p class="video-transition">
				Colocando projetos em prática é possível desenvolver interfaces
				bonitas, funcionais e com a sua própria identidade.
			</p>

			<!-- =========================
			     VÍDEO 2
			========================= -->

			<div class="video-showcase">
				<div class="video-frame">

					<div class="video-topbar" aria-hidden="true">
						<div class="window-dots">
							<span></span>
							<span></span>
							<span></span>
						</div>

						<div class="video-title">
							<span class="status-dot"></span>
							DevLearn — Coding
						</div>

						<div class="video-status">
							<span></span>
							Em execução
						</div>
					</div>

					<div class="video-content">

						<video
							class="coding-video"
							autoplay
							loop
							muted
							playsinline
							preload="metadata"
							aria-label="Demonstração de programação no DevLearn"
						>
							<source
								src="/public/Videos/coding2.mp4"
								type="video/mp4"
							/>

							Seu navegador não suporta vídeos HTML5.
						</video>

						<div
							class="video-overlay"
							aria-hidden="true"
						></div>

						<div class="video-caption">
							<div class="caption-line"></div>

							<div>
								<span>DO APRENDIZADO</span>
								<strong>PARA O CÓDIGO</strong>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* =========================
	   SECTION
	========================= */

	.learn {
		padding: 72px 0 34px;
	}

	.section-heading {
		max-width: 42rem;
		margin: 0 auto 30px;
		text-align: center;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		margin-bottom: 10px;
		color: #ff75b7;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.section-heading h2 {
		margin: 0;

		background: linear-gradient(
			100deg,
			#ffffff 8%,
			#d6b5ff 52%,
			#ff75b7 100%
		);

		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;

		font-size: clamp(1.75rem, 3.2vw, 2.55rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.learn-lead {
		margin: 12px 0 0;
		color: #b7b9c9;
		font-size: 0.98rem;
		line-height: 1.6;
	}

	/* =========================
	   PAINEL
	========================= */

	.panel {
		position: relative;
		overflow: hidden;
		padding: 30px 28px;

		border: 1px solid rgb(192 132 252 / 24%);
		border-radius: 24px;

		background: linear-gradient(
			135deg,
			#11152f 0%,
			#0d1228 52%,
			#101936 100%
		);

		box-shadow:
			0 18px 40px rgb(2 4 22 / 38%),
			inset 0 1px 0 rgb(255 255 255 / 6%);

		isolation: isolate;
	}

	.panel::before {
		position: absolute;
		inset: -20%;
		z-index: -1;

		content: '';

		background: radial-gradient(
			circle at 30% 30%,
			rgb(139 60 224 / 22%),
			transparent 40%
		);

		will-change: transform;

		animation:
			learn-panel-drift
			18s
			ease-in-out
			infinite
			alternate;
	}

	@keyframes learn-panel-drift {
		0% {
			transform: translate3d(0, 0, 0);
		}

		100% {
			transform: translate3d(6%, 4%, 0);
		}
	}

	/* =========================
	   CARDS
	========================= */

	.grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 18px;
	}

	.card {
		position: relative;
		overflow: hidden;

		display: flex;
		flex-direction: column;
		align-items: flex-start;

		gap: 12px;

		min-height: 178px;
		padding: 18px 18px 20px;

		border: 1px solid rgb(255 255 255 / 14%);
		border-radius: 16px;

		background: linear-gradient(
			180deg,
			rgb(255 255 255 / 10%),
			rgb(40 20 140 / 22%)
		);

		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 18%);

		text-align: left;
		text-decoration: none;

		transition:
			transform 0.3s ease,
			border-color 0.3s ease,
			box-shadow 0.3s ease,
			background 0.3s ease;

		isolation: isolate;
	}

	.card-glow {
		position: absolute;
		inset: -40%;
		z-index: -1;

		background: radial-gradient(
			circle,
			color-mix(
				in srgb,
				var(--topic-color),
				transparent 40%
			),
			transparent 62%
		);

		opacity: 0;
		transform: scale(0.7);

		transition:
			opacity 0.3s ease,
			transform 0.4s ease;
	}

	.card::after {
		position: absolute;
		right: 18%;
		bottom: 0;
		left: 18%;

		height: 3px;

		content: '';

		border-radius: 3px 3px 0 0;
		background: var(--topic-color);

		transform: scaleX(0);
		transform-origin: center;

		transition: transform 0.3s ease;
	}

	.card:hover {
		border-color: color-mix(
			in srgb,
			var(--topic-color),
			white 20%
		);

		background: linear-gradient(
			180deg,
			rgb(255 255 255 / 16%),
			rgb(49 27 154 / 38%)
		);

		box-shadow:
			0 16px 28px rgb(18 10 90 / 28%),
			inset 0 1px 0 rgb(255 255 255 / 28%);

		transform: translateY(-8px) scale(1.02);
	}

	.card:hover .card-glow {
		opacity: 1;
		transform: scale(1);
	}

	.card:hover::after {
		transform: scaleX(1);
	}

	.card.is-coming-soon {
		cursor: default;
		opacity: 0.68;
	}

	.card.is-coming-soon:hover {
		opacity: 0.85;
		transform: translateY(-3px);
		box-shadow: none;
	}

	.card-badge {
		align-self: flex-start;

		padding: 4px 10px;

		border: 1px solid rgb(255 255 255 / 18%);
		border-radius: 999px;

		background: rgb(255 255 255 / 6%);
		color: #b7b9c9;

		font-size: 0.62rem;
		font-weight: 700;

		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.card-badge.is-available {
		border-color: color-mix(
			in srgb,
			var(--topic-color),
			transparent 30%
		);

		background: color-mix(
			in srgb,
			var(--topic-color),
			transparent 82%
		);

		color: var(--topic-color);
	}

	.card-icon {
		display: grid;
		place-items: center;

		width: 52px;
		height: 52px;

		border-radius: 14px;

		background: color-mix(
			in srgb,
			var(--topic-color),
			transparent 78%
		);

		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 14%);

		transition:
			transform 0.3s ease,
			background 0.3s ease;
	}

	.card:hover .card-icon {
		background: color-mix(
			in srgb,
			var(--topic-color),
			transparent 60%
		);

		transform:
			translateY(-2px)
			rotate(-4deg)
			scale(1.06);
	}

	.card-icon img {
		width: 28px;
		height: 28px;

		filter:
			drop-shadow(
				0 0 6px rgb(255 255 255 / 25%)
			);
	}

	.card-copy {
		margin-top: auto;
	}

	.card-title {
		margin: 0 0 4px;

		color: #fff;

		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.card-desc {
		margin: 0;

		color: #9a9bb0;

		font-size: 0.76rem;
		line-height: 1.4;
	}

	.card-arrow {
		position: absolute;
		top: 16px;
		right: 16px;

		display: grid;
		place-items: center;

		width: 26px;
		height: 26px;

		border: 1px solid rgb(255 255 255 / 16%);
		border-radius: 50%;

		color: #b7b9c9;

		opacity: 0;

		transform:
			translate(-4px, 4px);

		transition:
			opacity 0.25s ease,
			transform 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease;
	}

	.card-arrow svg {
		width: 13px;
		height: 13px;

		fill: none;
		stroke: currentColor;

		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.card:hover .card-arrow {
		border-color: var(--topic-color);
		color: var(--topic-color);

		opacity: 1;

		transform: translate(0, 0);
	}

	.card:focus-visible {
		outline: 3px solid rgb(255 117 183 / 55%);
		outline-offset: 2px;
	}

	/* =========================
	   PRÁTICA
	========================= */

	.practice-heading {
		max-width: 650px;

		margin: 56px auto 26px;

		text-align: center;
	}

	.practice-label {
		display: inline-flex;
		align-items: center;
		gap: 7px;

		margin-bottom: 10px;

		color: #ff75b7;

		font-size: 0.67rem;
		font-weight: 800;

		letter-spacing: 0.14em;
	}

	.practice-dot {
		width: 6px;
		height: 6px;

		border-radius: 50%;

		background: #ff4fa3;

		box-shadow:
			0 0 10px rgb(255 79 163 / 80%);
	}

	.practice-heading h3 {
		margin: 0;

		color: #fff;

		font-size: clamp(
			1.4rem,
			2.5vw,
			2rem
		);

		font-weight: 700;
		line-height: 1.2;

		letter-spacing: -0.02em;
	}

	.practice-heading p {
		max-width: 570px;

		margin: 10px auto 0;

		color: #9fa2b8;

		font-size: 0.9rem;
		line-height: 1.6;
	}

	/* =========================
	   JORNADA
	========================= */

	.journey {
		display: flex;
		align-items: center;
		justify-content: center;

		gap: 14px;

		margin: 0 auto 30px;

		padding: 14px 18px;

		border: 1px solid rgb(255 255 255 / 8%);
		border-radius: 16px;

		background: rgb(255 255 255 / 3%);
	}

	.journey-step {
		display: flex;
		align-items: center;
		gap: 8px;

		white-space: nowrap;
	}

	.journey-number {
		display: grid;
		place-items: center;

		width: 25px;
		height: 25px;

		border: 1px solid rgb(192 132 252 / 30%);
		border-radius: 7px;

		background: rgb(139 60 224 / 12%);

		color: #d6b5ff;

		font-size: 0.56rem;
		font-weight: 800;
	}

	.journey-label {
		color: #c2c4d3;

		font-size: 0.69rem;
		font-weight: 600;
	}

	.journey-arrow {
		color: #765b91;

		font-size: 0.9rem;
	}

	/* =========================
	   VIDEO
	========================= */

	.video-showcase {
		position: relative;

		max-width: 640px;
		margin: 0 auto;
	}

	.video-frame {
		position: relative;
		overflow: hidden;

		border: 1px solid rgb(192 132 252 / 28%);
		border-radius: 20px;

		background: #080b1c;

		box-shadow:
			0 20px 45px rgb(2 4 22 / 42%),
			0 0 50px rgb(139 60 224 / 10%),
			inset 0 1px 0 rgb(255 255 255 / 8%);

		isolation: isolate;
	}

	.video-frame::before {
		position: absolute;
		inset: 0;
		z-index: 3;

		pointer-events: none;

		content: '';

		border-radius: inherit;

		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 4%);
	}

	.video-topbar {
		position: relative;
		z-index: 4;

		display: flex;
		align-items: center;
		justify-content: space-between;

		height: 42px;

		padding: 0 16px;

		border-bottom: 1px solid rgb(255 255 255 / 8%);

		background: linear-gradient(
			180deg,
			rgb(255 255 255 / 7%),
			rgb(255 255 255 / 3%)
		);

		backdrop-filter: blur(12px);
	}

	.window-dots {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.window-dots span {
		width: 8px;
		height: 8px;

		border-radius: 50%;

		background: rgb(255 255 255 / 25%);
	}

	.video-title {
		display: flex;
		align-items: center;
		gap: 8px;

		color: #a7a9bd;

		font-size: 0.7rem;
		font-weight: 600;

		letter-spacing: 0.02em;
	}

	.status-dot {
		width: 6px;
		height: 6px;

		border-radius: 50%;

		background: #ff4fa3;

		box-shadow:
			0 0 8px rgb(255 79 163 / 80%);

		animation:
			video-status-pulse
			2s
			ease-in-out
			infinite;
	}

	.video-status {
		display: flex;
		align-items: center;
		gap: 6px;

		color: #73778f;

		font-size: 0.62rem;
	}

	.video-status span {
		width: 5px;
		height: 5px;

		border-radius: 50%;

		background: #4ade80;

		box-shadow:
			0 0 7px rgb(74 222 128 / 70%);
	}

	@keyframes video-status-pulse {
		0%,
		100% {
			opacity: 0.6;
			transform: scale(0.9);
		}

		50% {
			opacity: 1;
			transform: scale(1.15);
		}
	}

	.video-content {
		position: relative;

		overflow: hidden;

		width: 100%;

		aspect-ratio: 16 / 7;

		background:
			radial-gradient(
				circle at 50% 50%,
				rgb(139 60 224 / 10%),
				transparent 60%
			),
			#080b18;
	}

	.coding-video {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;
		object-position: center;
	}

	.video-overlay {
		position: absolute;
		inset: 0;
		z-index: 2;

		pointer-events: none;

		background:
			linear-gradient(
				90deg,
				rgb(8 11 24 / 10%),
				transparent 20%,
				transparent 80%,
				rgb(8 11 24 / 10%)
			),
			linear-gradient(
				180deg,
				rgb(8 11 24 / 8%),
				transparent 20%,
				transparent 80%,
				rgb(8 11 24 / 14%)
			);
	}

	.video-caption {
		position: absolute;
		right: 22px;
		bottom: 20px;
		z-index: 3;

		display: flex;
		align-items: center;
		gap: 10px;

		padding: 10px 13px;

		border: 1px solid rgb(255 255 255 / 10%);
		border-radius: 10px;

		background: rgb(8 11 24 / 72%);

		backdrop-filter: blur(10px);

		box-shadow:
			0 10px 30px rgb(0 0 0 / 20%);
	}

	.video-caption .caption-line {
		width: 2px;
		height: 26px;

		border-radius: 2px;

		background: linear-gradient(
			180deg,
			#b44cff,
			#ff4fa3
		);

		box-shadow:
			0 0 10px rgb(255 79 163 / 50%);
	}

	.video-caption div:last-child {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.video-caption span {
		color: #a4a6b9;

		font-size: 0.52rem;
		font-weight: 700;

		letter-spacing: 0.1em;
	}

	.video-caption strong {
		color: #fff;

		font-size: 0.67rem;
		font-weight: 700;

		letter-spacing: 0.04em;
	}

	.video-description {
		max-width: 620px;

		margin: 14px auto 0;

		color: #85899f;

		font-size: 0.75rem;
		line-height: 1.5;

		text-align: center;
	}

	/* =========================
	   TEXTO DE TRANSIÇÃO ENTRE VÍDEOS
	========================= */

	.video-transition {
		max-width: 560px;

		margin: 28px auto;

		color: #c2c4d3;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.6;
		text-align: center;
	}

	/* =========================
	   REDUÇÃO DE MOVIMENTO
	========================= */

