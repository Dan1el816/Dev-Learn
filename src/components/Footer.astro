<footer class="site-footer">
	<div class="container">
		<p class="welcome">Toda e Qualquer contribuição será bem vinda ;)</p>
		<p class="copy">© 2024. Todos os direitos reservados</p>
	</div>
</footer>

<style>
	.site-footer {
		padding: 28px 0 36px;
		text-align: center;
	}

	.welcome {
		margin: 0 0 6px;
		color: #d8d8ea;
		font-size: 0.92rem;
	}

	.copy {
		margin: 0;
		color: #8f90a8;
		font-size: 0.78rem;
	}

	.container {
		display: grid;
		justify-items: center;
	}

	@media (min-width: 720px) {
		.container {
			grid-template-columns: 1fr auto 1fr;
			align-items: end;
		}

		.copy {
			grid-column: 1;
			justify-self: start;
		}

		.welcome {
			grid-column: 2;
			margin: 0;
		}
	}
</style>
