---
import { Image } from 'astro:assets';
import danielPhoto from '../assets/profiles/daniel.jpg';
import kauanPhoto from '../assets/profiles/kauan.jpg';
import linkedin from '../assets/social/linkedin.svg';
import instagram from '../assets/social/instagram.svg';
import discord from '../assets/social/discord.svg';
import github from '../assets/social/github.svg';
import globe from '../assets/social/globe.svg';
import javascript from '../assets/tech/javascript.svg';
import react from '../assets/tech/react.svg';
import html5 from '../assets/tech/html5.svg';
import python from '../assets/tech/python.svg';
import java from '../assets/tech/java.svg';
import linux from '../assets/tech/linux.svg';
import vscode from '../assets/tech/vscode.svg';

const social = [
	{ href: '#', src: linkedin, label: 'LinkedIn' },
	{ href: '#', src: instagram, label: 'Instagram' },
	{ href: '#', src: discord, label: 'Discord' },
	{ href: '#', src: github, label: 'GitHub' },
	{ href: '#', src: globe, label: 'Site' },
];
---

<section class="contributors">
	<div class="container">
		<div class="contributors-frame">
			<h2>Contribuidores</h2>

			<article class="profile profile-daniel">
			<div class="bio">
				<p>
					Graduando em Analise e Desenvolvimento de Sistemas no IFRN, com foco em desenvolvimento de software.
					Buscando desenvolver soluções eficientes e adquirir experiência por meio de projetos e desafios profissionais.
				</p>
				<div class="tech tech-daniel">
					<img src={javascript.src} width="56" height="56" alt="JavaScript" />
					<img class="react" src={react.src} width="120" height="40" alt="React" />
					<img src={html5.src} width="56" height="56" alt="HTML5" />
				</div>
			</div>
			<div class="person">
				<h3>Daniel Berg</h3>
				<div class="avatar">
					<Image src={danielPhoto} alt="Foto de Daniel Berg" width={220} height={220} />
				</div>
				<nav class="social" aria-label="Redes de Daniel Berg">
					{social.map((item) => (
						<a href={item.href} aria-label={item.label}>
							<img src={item.src.src} width="22" height="22" alt="" />
						</a>
					))}
				</nav>
			</div>
			</article>

			<article class="profile profile-kauan">
			<div class="person">
				<h3>José Kauan</h3>
				<div class="avatar">
					<Image src={kauanPhoto} alt="Foto de José Kauan" width={220} height={220} />
				</div>
				<nav class="social" aria-label="Redes de José Kauan">
					{social.map((item) => (
						<a href={item.href} aria-label={item.label}>
							<img src={item.src.src} width="22" height="22" alt="" />
						</a>
					))}
				</nav>
			</div>
			<div class="bio">
				<p>
					Atualmente, Graduando em ciência da computação pela Universidade Federal de Campina Grande (UFCG) com
					foco em back-end e qualidade de sistemas mas almejando se tornar full-stack e design, sempre a disposição :)
				</p>
				<div class="tech tech-kauan">
					<img src={python.src} width="56" height="56" alt="Python" />
					<img src={java.src} width="56" height="56" alt="Java" />
					<img src={linux.src} width="56" height="56" alt="Linux" />
					<img class="vscode" src={vscode.src} width="64" height="64" alt="VS Code" />
				</div>
			</div>
			</article>
		</div>
	</div>
</section>

<style>
	.contributors {
		padding: 56px 0 24px;
	}

	.contributors-frame {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 32px 34px 4px;
		border: 1px solid transparent;
		border-radius: 14px;
		background: rgb(11 15 40 / 96%);
		box-shadow: 0 20px 48px rgb(2 4 22 / 28%), inset 0 1px 0 rgb(255 255 255 / 8%);
	}

	.contributors-frame::before,
	.contributors-frame::after {
		position: absolute;
		content: '';
		pointer-events: none;
	}

	.contributors-frame::before {
		inset: -50%;
		z-index: -2;
		background: conic-gradient(from 0deg, transparent 0deg, #ff4fa3 48deg, #8b3ce0 100deg, transparent 150deg, transparent 280deg, #5b8cff 320deg, transparent 360deg);
		animation: orbit-outline 8s linear infinite;
	}

	.contributors-frame::after {
		inset: 1px;
		z-index: -1;
		border-radius: 13px;
		background: rgb(11 15 40 / 98%);
	}

	@keyframes orbit-outline {
		to {
			transform: rotate(360deg);
		}
	}

	h2 {
		margin: 0 0 36px;
		color: #c084fc;
		font-size: clamp(1.45rem, 2.4vw, 1.85rem);
		font-weight: 700;
	}

	.profile {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 36px 48px;
		align-items: center;
		margin-bottom: 56px;
		padding: 20px 0;
	}

	.profile-kauan {
		grid-template-columns: 0.85fr 1.15fr;
	}

	.bio p {
		margin: 0;
		max-width: 36rem;
		color: #e4e4f4;
		font-size: 0.98rem;
		font-weight: 400;
		line-height: 1.7;
		text-align: center;
	}

	.profile-kauan .bio p {
		text-align: right;
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 18px 22px;
		margin-top: 28px;
	}

	.tech-daniel {
		justify-content: flex-start;
		padding-left: 8px;
	}

	.tech-kauan {
		justify-content: flex-end;
	}

	.tech img {
		width: 52px;
		height: 52px;
		object-fit: contain;
	}

	.tech .react {
		width: 118px;
		height: 40px;
	}

	.tech .vscode {
		width: 58px;
		height: 58px;
	}

	.person {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	h3 {
		margin: 0 0 16px;
		color: #c4b5fd;
		font-size: 1.15rem;
		font-weight: 600;
	}

	.avatar {
		width: 184px;
		height: 184px;
		overflow: hidden;
		border: 4px solid #f4f1ff;
		border-radius: 50%;
		box-shadow: 0 0 0 4px rgb(196 165 255 / 18%), 0 10px 28px rgb(0 0 0 / 35%);
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 18%;
	}

	.profile-kauan .avatar img {
		object-position: 50% 12%;
	}

	.social {
		display: flex;
		gap: 14px;
		margin-top: 16px;
	}

	.social a {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		color: #ff4fa3;
	}

	.social img {
		width: 22px;
		height: 22px;
		filter: invert(48%) sepia(84%) saturate(1800%) hue-rotate(292deg) brightness(104%) contrast(104%);
	}

	@media (max-width: 800px) {
		.contributors-frame {
			padding: 24px 18px 2px;
		}

		.profile,
		.profile-kauan {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.bio p,
		.profile-kauan .bio p {
			text-align: center;
		}

		.tech,
		.tech-kauan {
			justify-content: center;
		}

		.person {
			order: -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contributors-frame::before {
			animation: none;
		}
	}
</style>
