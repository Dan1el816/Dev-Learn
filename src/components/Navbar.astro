---
const links = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Projetos', href: '/projetos' },
	{ label: 'Conteúdos', href: '/conteudos' },
	{ label: 'Sobre', href: '/sobre' },
	{ label: 'Contato', href: '/contato' },
];
---

<header class="site-header">
	<nav class="navbar" aria-label="Navegacao principal">
		<a class="brand" href="/" aria-label="DevLearn - pagina inicial">
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M12 2L20 8V16L12 22L4 16V8L12 2Z" fill="url(#header-gradient)" />
					<defs>
						<linearGradient id="header-gradient" x1="4" y1="2" x2="20" y2="22" gradientUnits="userSpaceOnUse">
							<stop offset="0" stop-color="#e6376c" />
							<stop offset="1" stop-color="#8b3ce0" />
						</linearGradient>
					</defs>
				</svg>
			</span>
			<span class="brand-text">Dev<br />Learn</span>
		</a>

		<button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-links">
			<span></span>
			<span></span>
			<span></span>
		</button>

		<div class="nav-links" id="nav-links">
			{links.map((link, index) => (
				<a class:list={{ active: index === 0 }} href={link.href}>{link.label}</a>
			))}
			<a class="action-link" href="/contato">Saber mais</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
    position: relative;
    z-index: 10;
    padding: 18px 24px;
    background: none;
}

	.navbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		max-width: 1240px;
		margin: 0 auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		flex-shrink: 0;
	}

	.brand-mark svg {
		width: 100%;
		height: 100%;
	}

	.brand-text {
		color: #ffffff;
		font-family: var(--font-body);
		font-size: 1.28rem;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: 0.02em;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 32px;
		margin-right: -16px;
	}

	.nav-links a {
		position: relative;
		padding: 8px 0;
		color: #b7b9c9;
		font-family: var(--font-body);
		font-size: 0.98rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		text-decoration: none;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.nav-links a:not(.action-link)::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 2px;
		content: '';
		border-radius: 2px;
		background: linear-gradient(90deg, #9b32ff, #ff3f91);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 0.25s ease;
	}

	.nav-links a:not(.action-link):hover,
	.nav-links a.active:not(.action-link) {
		color: #ffffff;
		transform: translateY(-2px);
	}

	.nav-links a:not(.action-link):hover::after,
	.nav-links a.active:not(.action-link)::after {
		transform: scaleX(1);
	}

	.nav-links a:not(.action-link):hover {
		color: transparent;
		background: linear-gradient(90deg, #9b32ff, #ff3f91);
		background-clip: text;
		-webkit-background-clip: text;
	}

	.action-link {
		position: relative;
		overflow: hidden;
		padding: 11px 22px !important;
		border: 1px solid rgb(255 117 183 / 45%);
		color: #ffffff !important;
		border-radius: 999px;
		background: linear-gradient(90deg, #e6376c, #8b3ce0);
		font-size: 0.95rem !important;
		font-weight: 600;
		white-space: nowrap;
		box-shadow: 0 8px 24px rgb(193 59 255 / 28%);
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease,
			border-color 0.3s ease,
			background 0.3s ease;
	}

	.action-link::before {
		position: absolute;
		inset: 0;
		content: '';
		background: linear-gradient(
			120deg,
			transparent 25%,
			rgb(255 255 255 / 45%),
			transparent 75%
		);
		transform: translateX(-130%);
		transition: transform 0.5s ease;
	}

	.action-link::after {
		display: none;
	}

	.action-link:hover {
		border-color: #ffb3d6;
		background: linear-gradient(90deg, #ff75b7, #8b3ce0);
		box-shadow:
			0 0 0 4px rgb(255 79 163 / 12%),
			0 12px 28px rgb(255 79 163 / 42%);
		transform: translateY(-4px) scale(1.04);
	}

	.action-link:hover::before {
		transform: translateX(130%);
	}

	.action-link:focus-visible {
		outline: 3px solid rgb(255 117 183 / 55%);
		outline-offset: 4px;
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 34px;
		height: 34px;
		padding: 0;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.menu-toggle span {
		display: block;
		height: 2px;
		background: #ffffff;
		border-radius: 2px;
	}

	@media (max-width: 700px) {
		.site-header {
			padding: 14px 16px;
		}

		.menu-toggle {
			display: flex;
		}

		.nav-links {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    margin-right: 0;
    padding: 16px;
    background: none;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    transform: scaleY(0);
    transform-origin: top;
    opacity: 0;
    pointer-events: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
}

		.nav-links.open {
			transform: scaleY(1);
			opacity: 1;
			pointer-events: auto;
		}

		.nav-links a {
			width: 100%;
			padding: 10px 0;
		}

		.action-link {
			width: 100%;
			margin-top: 8px;
			text-align: center;
		}
	}
</style>

<script>
	const toggle = document.querySelector('.menu-toggle');
	const links = document.getElementById('nav-links');

	toggle?.addEventListener('click', () => {
		const isOpen = links?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});
</script>
