---
const parts = [
	{ number: 1, title: 'Introdução ao Python', href: '/linguagens/python' },
	{ number: 2, title: 'Fundamentos da linguagem', href: '/linguagens/python/parte-2' },
	{ number: 3, title: 'Operadores e expressões', href: null },
	{ number: 4, title: 'Estruturas condicionais', href: null },
	{ number: 5, title: 'Estruturas de repetição', href: null },
	{ number: 6, title: 'Estruturas de dados', href: null },
	{ number: 7, title: 'Funções', href: null },
	{ number: 8, title: 'Organização do código', href: null },
	{ number: 9, title: 'Tratamento de erros', href: null },
	{ number: 10, title: 'Manipulação de arquivos', href: null },
	{ number: 11, title: 'Programação Orientada a Objetos', href: null },
	{ number: 12, title: 'Python intermediário', href: null },
	{ number: 13, title: 'Testes e qualidade', href: null },
	{ number: 14, title: 'Bibliotecas e ecossistema', href: null },
	{ number: 15, title: 'Python para Web', href: null },
	{ number: 16, title: 'Banco de dados', href: null },
	{ number: 17, title: 'Automação', href: null },
	{ number: 18, title: 'Ciência de dados', href: null },
	{ number: 19, title: 'Inteligência Artificial', href: null },
	{ number: 20, title: 'Projetos', href: null },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const currentPart = parts.find((part) => part.href === currentPath);
---

<aside class="course-sidebar" aria-label="Navegação do curso de Python">
	<details class="course-index">
		<summary>
			<span class="summary-copy">
				<span class="eyebrow">Curso</span>
				<span class="summary-title">Python</span>
			</span>
			<span class="summary-current">
				{currentPart ? `Parte ${currentPart.number}` : 'Todas as partes'}
			</span>
			<svg viewBox="0 0 20 20" aria-hidden="true">
				<path d="m5 7.5 5 5 5-5" />
			</svg>
		</summary>

		<div class="index-content">
			<div class="index-heading">
				<p class="eyebrow">Trilha de aprendizado</p>
				<h2>Mapa do curso</h2>
				<p>As próximas partes serão disponibilizadas em breve.</p>
			</div>

			<nav aria-label="Partes do curso de Python">
				<ol>
					{parts.map((part) => {
						const isCurrent = part.href === currentPath;
						const isAvailable = part.href !== null;
						const status = isCurrent ? 'Estudando' : isAvailable ? 'Disponível' : 'Em breve';

						return (
							<li>
								{isAvailable ? (
									<a
										class:list={{ 'part-link': true, current: isCurrent }}
										href={part.href}
										aria-current={isCurrent ? 'page' : undefined}
									>
										<span class="part-marker" aria-hidden="true">
											{isCurrent ? '●' : '○'}
										</span>
										<span class="part-copy">
											<span class="part-number">Parte {part.number}</span>
											<span class="part-title">{part.title}</span>
										</span>
										<span class="part-status">{status}</span>
									</a>
								) : (
									<div class="part-link unavailable" aria-disabled="true">
										<span class="part-marker" aria-hidden="true">○</span>
										<span class="part-copy">
											<span class="part-number">Parte {part.number}</span>
											<span class="part-title">{part.title}</span>
										</span>
										<span class="part-status">{status}</span>
									</div>
								)}
							</li>
						);
					})}
				</ol>
			</nav>
		</div>
	</details>
</aside>

<style>
	.course-sidebar {
		position: sticky;
		top: 20px;
		align-self: start;
		min-width: 0;
	}

	.course-index {
		overflow: hidden;
		border: 1px solid rgb(192 132 252 / 18%);
		border-radius: 18px;
		background: color-mix(in srgb, var(--color-surface) 92%, transparent);
		box-shadow: 0 12px 30px rgb(0 0 0 / 20%);
	}

	summary {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px;
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.summary-copy {
		display: grid;
		gap: 1px;
		margin-right: auto;
	}

	.eyebrow {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.summary-title {
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 700;
	}

	.summary-current {
		padding: 4px 9px;
		border: 1px solid rgb(192 132 252 / 25%);
		border-radius: 999px;
		color: var(--color-accent);
		font-size: 0.68rem;
		font-weight: 600;
		white-space: nowrap;
	}

	summary svg {
		width: 18px;
		height: 18px;
		flex: 0 0 auto;
		fill: none;
		stroke: var(--color-muted);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
		transition: transform 0.2s ease;
	}

	details[open] summary svg {
		transform: rotate(180deg);
	}

	.index-content {
		padding: 0 10px 10px;
	}

	.index-heading {
		padding: 8px 8px 14px;
	}

	.index-heading h2 {
		margin: 4px 0;
		color: var(--color-text);
		font-size: 1.05rem;
		line-height: 1.4;
	}

	.index-heading > p:last-child {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.72rem;
		line-height: 1.5;
	}

	ol {
		display: grid;
		gap: 4px;
		max-height: calc(100vh - 190px);
		overflow-y: auto;
		margin: 0;
		padding: 0 4px 2px 0;
		list-style: none;
		scrollbar-color: rgb(192 132 252 / 38%) transparent;
		scrollbar-width: thin;
	}

	.part-link {
		display: grid;
		grid-template-columns: 18px minmax(0, 1fr);
		align-items: start;
		gap: 8px;
		padding: 9px 8px;
		border: 1px solid transparent;
		border-radius: 11px;
		color: var(--color-body);
		transition:
			background-color 0.18s ease,
			border-color 0.18s ease,
			transform 0.18s ease;
	}

	a.part-link:hover {
		border-color: rgb(192 132 252 / 18%);
		background: rgb(192 132 252 / 7%);
		transform: translateX(2px);
	}

	.part-link.current {
		border-color: rgb(192 132 252 / 35%);
		background: linear-gradient(105deg, rgb(139 60 224 / 20%), rgb(230 55 108 / 8%));
	}

	.part-marker {
		padding-top: 1px;
		color: var(--color-muted);
		font-size: 0.8rem;
		line-height: 1.5;
		text-align: center;
	}

	.current .part-marker {
		color: var(--color-accent-pink);
	}

	.part-copy {
		display: grid;
		min-width: 0;
		gap: 1px;
	}

	.part-number {
		color: var(--color-muted);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.part-title {
		color: var(--color-body);
		font-size: 0.74rem;
		font-weight: 500;
		line-height: 1.45;
		overflow-wrap: anywhere;
	}

	.current .part-title {
		color: var(--color-text);
		font-weight: 600;
	}

	.part-status {
		grid-column: 2;
		color: var(--color-muted);
		font-size: 0.62rem;
		line-height: 1.4;
	}

	.current .part-status {
		color: var(--color-accent);
	}

	.unavailable {
		opacity: 0.66;
		cursor: not-allowed;
	}

	@media (min-width: 1001px) {
		.course-index > summary {
			display: none;
		}

		.course-index:not([open]) > .index-content {
			display: block;
		}
	}

	@media (max-width: 1000px) {
		.course-sidebar {
			position: static;
		}

		.course-index[open] .index-content {
			padding-top: 2px;
		}

		ol {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			max-height: min(55vh, 460px);
		}
	}

	@media (max-width: 520px) {
		summary {
			padding: 12px 14px;
		}

		ol {
			grid-template-columns: 1fr;
		}

		.part-link {
			grid-template-columns: 18px minmax(0, 1fr) auto;
			align-items: center;
		}

		.part-status {
			grid-column: auto;
			text-align: right;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		summary svg,
		.part-link {
			transition: none;
		}

		a.part-link:hover {
			transform: none;
		}
	}
</style>
